// Copy of PJ::colormapGlsl() (pj_widgets/src/Colormap.cpp) for the qsb-baked point and grid-map
// shaders, which can only #include files. scene3d_shader_constants_test fails when the
// two differ: edit Colormap.cpp, then paste its string here.

vec3 turbo(float t) {
  const vec4 kRedVec4   = vec4(0.13572138, 4.61539260, -42.66032258, 132.13108234);
  const vec4 kGreenVec4 = vec4(0.09140261, 2.19418839,   4.84296658, -14.18503333);
  const vec4 kBlueVec4  = vec4(0.10667330, 12.64194608, -60.58204836, 110.36276771);
  const vec2 kRedVec2   = vec2(-152.94239396,  59.28637943);
  const vec2 kGreenVec2 = vec2(  4.27729857,   2.82956604);
  const vec2 kBlueVec2  = vec2(-89.90310912,  27.34824973);

  t = clamp(t, 0.0, 1.0);
  vec4 v4 = vec4(1.0, t, t * t, t * t * t);
  vec2 v2 = v4.zw * v4.z;
  return vec3(
    dot(v4, kRedVec4)   + dot(v2, kRedVec2),
    dot(v4, kGreenVec4) + dot(v2, kGreenVec2),
    dot(v4, kBlueVec4)  + dot(v2, kBlueVec2)
  );
}

// Matt Zucker's polynomial approximation of matplotlib's viridis.
vec3 viridis(float t) {
  const vec3 c0 = vec3(0.2777273272234177, 0.005407344544966578, 0.3340998053353061);
  const vec3 c1 = vec3(0.1050930431085774, 1.404613529898575,    1.384590162594685);
  const vec3 c2 = vec3(-0.3308618287255563, 0.214847559468213,   0.09509516302823659);
  const vec3 c3 = vec3(-4.634230498983486, -5.799100973351585, -19.33244095627987);
  const vec3 c4 = vec3(6.228269936347081,  14.17993336680509,   56.69055260068105);
  const vec3 c5 = vec3(4.776384997670288, -13.74514537774601,  -65.35303263337234);
  const vec3 c6 = vec3(-5.435455855934631,  4.645852612178535,  26.3124352495832);
  return c0 + t * (c1 + t * (c2 + t * (c3 + t * (c4 + t * (c5 + t * c6)))));
}

// Matt Zucker's polynomial approximation of matplotlib's plasma.
vec3 plasma(float t) {
  const vec3 c0 = vec3(0.05873234392399702, 0.02333670892565664, 0.5433401826748754);
  const vec3 c1 = vec3(2.176514634195958,   0.2383834171260182,  0.7539604599784036);
  const vec3 c2 = vec3(-2.689460476458034, -7.455851135738909,   3.110799939717086);
  const vec3 c3 = vec3(6.130348345893603,  42.3461881477227,   -28.51885465332158);
  const vec3 c4 = vec3(-11.10743619062271, -82.66631109428045,  60.13984767418263);
  const vec3 c5 = vec3(10.02306557647065,  71.41361770095349, -54.07218655560067);
  const vec3 c6 = vec3(-3.658713842777788, -22.93153465461149, 18.19190778539828);
  return c0 + t * (c1 + t * (c2 + t * (c3 + t * (c4 + t * (c5 + t * c6)))));
}

vec3 sampleColormap(int id, float t) {
  t = clamp(t, 0.0, 1.0);
  if (id == 0) return turbo(t);
  if (id == 1) return viridis(t);
  if (id == 2) return plasma(t);
  return vec3(t);  // grayscale
}
