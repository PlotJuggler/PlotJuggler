// The shadow-map lookup of every shadow receiver (model.frag, grid_cell.frag's
// PJ_GRID_SHADOW build). The includer declares light_view_projection (world ->
// shadow-map texture space: u, v, stored depth), shadow_params (y: the filter
// radius in texels, at least 1) and the shadow_map sampler first.

// The lit fraction at `biased` (the receiver position, already pushed off its
// surface): a 16-tap Poisson PCF around its light-space projection. Outside the
// shadow map's volume a point is lit.
float shadowMapLit(vec3 biased) {
    vec4 light_clip = light_view_projection * vec4(biased, 1.0);
    vec3 projected = light_clip.xyz / light_clip.w;
    if (projected.x < 0.0 || projected.x > 1.0 || projected.y < 0.0 || projected.y > 1.0 ||
        projected.z > 1.0) {
        return 1.0;
    }
    const vec2 poisson[16] = vec2[](
        vec2(-0.942, -0.399), vec2(0.946, -0.769), vec2(-0.094, -0.929), vec2(0.345, 0.294),
        vec2(-0.916, 0.458), vec2(-0.815, -0.879), vec2(-0.383, 0.277), vec2(0.975, 0.756),
        vec2(0.443, -0.975), vec2(0.537, -0.474), vec2(-0.265, -0.419), vec2(0.792, 0.191),
        vec2(-0.242, 0.997), vec2(-0.814, 0.914), vec2(0.200, 0.786), vec2(0.144, -0.141));
    vec2 texel = (1.0 / vec2(textureSize(shadow_map, 0))) * max(shadow_params.y, 1.0);
    float lit = 0.0;
    for (int index = 0; index < 16; ++index) {
        lit += projected.z <= texture(shadow_map, projected.xy + poisson[index] * texel).r ? 1.0 : 0.0;
    }
    return lit / 16.0;
}
