// The clip position of a GL_LINES vertex whose segment ends at `other_clip`. Chromium's SwiftShader drops a whole
// line with one vertex behind the eye (w < 0) instead of clipping it (TECHNICAL_NOTES "SwiftShader drops lines that
// cross behind the eye"): such a vertex moves along the segment to w = kMinClipW, below every perspective near plane
// (camera_math adaptiveNearFar's floor), so the rasterizer's own near clip leaves the visible segment unchanged. Clip
// space is linear along the segment. Guarded: several include chains may reach it.
#ifndef PJ_LINE_CLIP_GLSLINC
#define PJ_LINE_CLIP_GLSLINC

const float kMinClipW = 1e-4;

vec4 clipBehindEye(vec4 clip, vec4 other_clip) {
    if (clip.w < kMinClipW && other_clip.w > kMinClipW) {
        clip = mix(clip, other_clip, (kMinClipW - clip.w) / (other_clip.w - clip.w));
        clip.w = kMinClipW;  // float rounding of the mix leaves w off it, and exactly 0 on a large grid
    }
    return clip;
}

#endif  // PJ_LINE_CLIP_GLSLINC
