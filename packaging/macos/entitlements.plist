<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPDX-License-Identifier: MPL-2.0
  Hardened-runtime entitlements for plotjuggler4 and pj-plugin-check. Marketplace
  and user plugins are not signed by our team (official ones are ad-hoc signed by
  the linker), so library validation would refuse to load them.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
