# The staging directory lives under %TEMP% (see build_windows_installer.ps1), so
# nothing under packages/ should appear in a checkout; this ignores an in-tree stage.
packages/io.plotjuggler.application/data/
# Output produced by build_windows_installer.ps1 -OutDir <default '.'>.
# Name is PlotJuggler-<Version>-Windows-x64[.<short-commit>].exe; the glob also
# catches a prefix before PlotJuggler-.
**/*PlotJuggler-*Windows-x64*.exe
