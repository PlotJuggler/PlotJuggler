# syntax=docker/dockerfile:1
# SPDX-License-Identifier: MPL-2.0
#
# PlotJuggler 4 AppImage builder — one file, two targets:
#
#   * ci-base (docker build --target ci-base): THIN toolchain image for CI.
#     Ubuntu 22.04 (glibc 2.35 floor — hosted 22.04 runners retire 2027-04,
#     actions/runner-images#14254) + apt/pip build deps + pinned
#     linuxdeploy/appimagetool. NO Qt and NO Conan closure baked in: the CI
#     container job provisions those per-run from actions/cache + the JFrog
#     Conan remote (see .github/workflows/linux-appimage-release.yml).
#     Published to ghcr.io/plotjuggler/pj4-appimage-builder by
#     .github/workflows/appimage-builder-image.yml.
#
#   * default final stage: FULLY-BAKED local builder for
#     packaging/appimage/build_in_docker.sh — Qt (versions.env) and the prebuilt Conan
#     dep closure live in image layers so a container run fetches NOTHING (the
#     one exception is --plugins-registry, which downloads published plugin zips).
#
# The container runs as ROOT internally so it can read the baked /root/.conan2
# and /opt/.qt; the entrypoint chowns the generated build/ + *.AppImage back to
# the invoking host user (HOST_UID/HOST_GID). Root-then-chown avoids a fragile
# in-image UID match while keeping host outputs host-owned.
FROM ubuntu:22.04 AS ci-base

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# 1) Build + packaging deps. The Qt/XCB/VAAPI block is lifted VERBATIM from the
#    "Install Qt 6 + FFmpeg VAAPI system dependencies" step in linux-ci.yml so it
#    cannot drift from CI. xvfb omitted (no GUI tests here); imagemagick omitted
#    (the icon ships as committed resources/svg/plotjuggler4.png).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-dev libegl1-mesa-dev libxkbcommon-dev \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
        libxcb-xkb1 libxkbcommon-x11-0 libfontconfig1 libdbus-1-3 \
        libva-dev libdrm-dev \
        build-essential cmake ninja-build ccache git ca-certificates \
        wget curl file pkg-config python3 python3-pip \
        patchelf unzip zstd \
    && rm -rf /var/lib/apt/lists/*

# 2) Python tooling: aqt (Qt installer) + conan. Installing aqt up front means
#    scripts/install_qt6.sh finds it (command -v aqt) and SKIPS its own bare `pip install`.
RUN python3 -m pip install --no-cache-dir 'aqtinstall>=3.3' 'conan>=2,<3'

ARG PJ_APPIMAGE_ARCH
RUN test -n "$PJ_APPIMAGE_ARCH"
ENV PJ_APPIMAGE_ARCH=$PJ_APPIMAGE_ARCH

# 3) Bake PINNED linuxdeploy + its Qt plugin + appimagetool. All three publish
#    mainly rolling 'continuous' tags, so the PIN = freezing the exact bytes into
#    this layer (build_appimage.sh uses a pre-existing packaging/appimage/<name>.AppImage
#    instead of downloading). SHA256SUMS records provenance. The optional build
#    args, when non-empty, assert the bytes and FAIL the build on mismatch;
#    default empty = record-only.
ARG LINUXDEPLOY_SHA256=
ARG LINUXDEPLOY_QT_SHA256=
ARG APPIMAGETOOL_SHA256=
RUN mkdir -p /opt/linuxdeploy && cd /opt/linuxdeploy \
 && wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-${PJ_APPIMAGE_ARCH}.AppImage \
 && wget -q https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-${PJ_APPIMAGE_ARCH}.AppImage \
 && wget -q https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-${PJ_APPIMAGE_ARCH}.AppImage \
 && chmod +x linuxdeploy-${PJ_APPIMAGE_ARCH}.AppImage linuxdeploy-plugin-qt-${PJ_APPIMAGE_ARCH}.AppImage appimagetool-${PJ_APPIMAGE_ARCH}.AppImage \
 && if [ -n "${LINUXDEPLOY_SHA256}" ]; then echo "${LINUXDEPLOY_SHA256}  linuxdeploy-${PJ_APPIMAGE_ARCH}.AppImage" | sha256sum -c -; fi \
 && if [ -n "${LINUXDEPLOY_QT_SHA256}" ]; then echo "${LINUXDEPLOY_QT_SHA256}  linuxdeploy-plugin-qt-${PJ_APPIMAGE_ARCH}.AppImage" | sha256sum -c -; fi \
 && if [ -n "${APPIMAGETOOL_SHA256}" ]; then echo "${APPIMAGETOOL_SHA256}  appimagetool-${PJ_APPIMAGE_ARCH}.AppImage" | sha256sum -c -; fi \
 && sha256sum linuxdeploy-${PJ_APPIMAGE_ARCH}.AppImage linuxdeploy-plugin-qt-${PJ_APPIMAGE_ARCH}.AppImage appimagetool-${PJ_APPIMAGE_ARCH}.AppImage > SHA256SUMS \
 && cat SHA256SUMS

# ---------------------------------------------------------------------------
# Fully-baked local builder (default target) — used by build_in_docker.sh.
# ---------------------------------------------------------------------------
FROM ci-base

# 4) Bake Qt via the repo's scripts/install_qt6.sh using versions.env. Running it from
#    /opt lands Qt under /opt/.qt/ — a stable path outside the eventual /work bind mount.
ARG PJ_QT_VERSION
RUN test -n "$PJ_QT_VERSION"
ENV PJ_QT_VERSION=$PJ_QT_VERSION
COPY versions.env /opt/versions.env
COPY scripts/install_qt6.sh /opt/scripts/install_qt6.sh
RUN bash /opt/scripts/install_qt6.sh

# 5) Warm the Conan cache into /root/.conan2 with the SAME settings AND lockfile
#    build.sh uses, so the run-time conan install is an offline cache hit. The
#    lockfile is load-bearing: resolving conanfile.txt alone picks whatever the
#    remotes offer on bake day, which drifts from the revisions build.sh locks, and
#    every drifted package is then rebuilt from source inside each --rm container.
#    Dependency DWARF would otherwise be linked into every PJ4 executable;
#    PJ4's own debug info is governed by cmake/PjDebugInfo.cmake.
#    Clean BEFORE stripping: build folders of from-source packages hold thin
#    archives (dav1d's meson tools), which strip rejects. Only the clean step is
#    allowed to fail; a failed install or strip must fail the image build rather
#    than silently skip the cleanup and ship the build folders.
COPY conanfile.txt conan.lock /opt/conan-ctx/
COPY scripts/configure_conan_remote.sh /opt/configure_conan_remote.sh
RUN conan profile detect --force \
 && bash /opt/configure_conan_remote.sh \
 && conan install /opt/conan-ctx -r plotjuggler-conan -r conancenter \
        --lockfile=/opt/conan-ctx/conan.lock --lockfile-partial \
        --output-folder=/tmp/conan-warm --build=missing \
        -s build_type=RelWithDebInfo -s compiler.cppstd=20 \
 && rm -rf /tmp/conan-warm \
 && { conan cache clean "*" --build --source --temp || true; } \
 && find /root/.conan2/p -type f -name '*.a' -exec sh -c \
        'for f; do [ "$(head -c 7 "$f")" = "!<thin>" ] || strip --strip-debug "$f" || exit 1; done' _ {} +

# 6) Baked entrypoint (quoted heredoc => nothing expanded at image-build time).
RUN cat > /usr/local/bin/pj4-build-entry.sh <<'PJEOF'
#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# Entrypoint for the PJ4 AppImage builder image. Runs as root (reads baked
# /opt/.qt + /root/.conan2); hands outputs back to the host user via chown.
set -euo pipefail

HOST_UID="${HOST_UID:-0}"
HOST_GID="${HOST_GID:-0}"

git config --global --add safe.directory '*' || true

for tool in linuxdeploy linuxdeploy-plugin-qt appimagetool; do
  ln -sfn /opt/linuxdeploy/${tool}-${PJ_APPIMAGE_ARCH}.AppImage \
          /work/packaging/appimage/${tool}-${PJ_APPIMAGE_ARCH}.AppImage
done

cleanup() {
  local tool f
  for tool in linuxdeploy linuxdeploy-plugin-qt appimagetool; do
    rm -f /work/packaging/appimage/${tool}-${PJ_APPIMAGE_ARCH}.AppImage || true
  done
  chown -R "${HOST_UID}:${HOST_GID}" /work/build 2>/dev/null || true
  # Conan's CMakeToolchain generator writes CMakeUserPresets.json at the checkout
  # root and build.sh links compile_commands.json there; left root-owned they
  # make the next HOST `conan install` in the same checkout fail with EACCES.
  # -h: chown the symlink itself, never follow it.
  for f in /work/CMakeUserPresets.json /work/compile_commands.json; do
    chown -h "${HOST_UID}:${HOST_GID}" "$f" 2>/dev/null || true
  done
  shopt -s nullglob
  for f in /work/packaging/appimage/PlotJuggler-*-${PJ_APPIMAGE_ARCH}.AppImage; do
    chown "${HOST_UID}:${HOST_GID}" "$f" 2>/dev/null || true
  done
  shopt -u nullglob
}
trap cleanup EXIT

# Make /work/.qt/${PJ_QT_VERSION}/gcc_64 resolve to the baked Qt WITHOUT mutating the host.
# In a worktree, /work/.qt is an absolute symlink into the host primary checkout
# that dangles in-container; we materialize THAT target path inside the container
# layer (not under /work) and aim it at the baked Qt, leaving the host untouched.
QT_LINK="/work/.qt"
BAKED_QT="/opt/.qt"
if [[ ! -d "${QT_LINK}/${PJ_QT_VERSION}/gcc_64" ]]; then
  if [[ -L "${QT_LINK}" ]]; then
    qt_target="$(readlink "${QT_LINK}")"
    if [[ "${qt_target}" == /* ]]; then
      mkdir -p "$(dirname "${qt_target}")"
      ln -sfn "${BAKED_QT}" "${qt_target}"
    else
      rm -f "${QT_LINK}"; ln -sfn "${BAKED_QT}" "${QT_LINK}"
    fi
  else
    ln -sfn "${BAKED_QT}" "${QT_LINK}"
  fi
fi

export APPIMAGE_EXTRACT_AND_RUN=1

# PJ_BUILD_TESTS/PJ_BUILD_DEMOS/PJ_BUILD_WIDGET_DEMOS/PJ_BUILD_TARGET arrive from build_in_docker.sh (default: shipped closure only).
bash /work/build.sh
bash /work/packaging/appimage/build_appimage.sh "$@"
PJEOF
RUN chmod +x /usr/local/bin/pj4-build-entry.sh

ENTRYPOINT ["/usr/local/bin/pj4-build-entry.sh"]
