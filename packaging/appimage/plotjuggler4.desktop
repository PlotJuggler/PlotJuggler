[Desktop Entry]
Type=Application
Name=PlotJuggler 4
GenericName=Timeseries Visualization
Exec=plotjuggler4
Icon=plotjuggler4
Comment=Visualize timeseries like a pro
Terminal=false
Categories=Development;Science;Utility;
Keywords=plot;timeseries;ros;mcap;telemetry;
# Wayland compositors match a window to its launcher by app_id (set in main.cpp).
# Integration tools (AppImageLauncher, Gear Lever) rename this file, so the
# basename no longer matches; this key keeps the match.
StartupWMClass=plotjuggler4
