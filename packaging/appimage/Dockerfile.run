# syntax=docker/dockerfile:1
# SPDX-License-Identifier: MPL-2.0
#
# Clean runtime image for VERIFYING the PlotJuggler 4 AppImage runs on a clean
# Ubuntu with NO application dependencies. It installs ONLY the universal
# X11/OpenGL/font runtime libraries that linuxdeploy intentionally does NOT bundle
# (the "excludelist" — assumed present on any Linux desktop). There is deliberately
# NO Qt, NO build toolchain, NO Conan, NO FFmpeg/app deps here: if the AppImage
# runs against just these base libs, it is genuinely self-contained.
#
# Used by packaging/appimage/run_in_docker.sh, which forwards the host X server (xhost +
# $DISPLAY + /tmp/.X11-unix) and runs the mounted AppImage with
# --appimage-extract-and-run (no FUSE, no --privileged).
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglx0 libopengl0 libegl1 \
        libx11-6 libx11-xcb1 libxext6 libxrender1 libxi6 libxfixes3 \
        libxcb1 libxcb-cursor0 libxcb-glx0 libxcb-icccm4 libxcb-image0 \
        libxcb-keysyms1 libxcb-randr0 libxcb-render0 libxcb-render-util0 \
        libxcb-shape0 libxcb-shm0 libxcb-sync1 libxcb-util1 libxcb-xfixes0 \
        libxcb-xinerama0 libxcb-xkb1 \
        libxkbcommon0 libxkbcommon-x11-0 \
        libfontconfig1 libfreetype6 libdbus-1-3 libglib2.0-0 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# No ENTRYPOINT/CMD: run_in_docker.sh supplies the AppImage path + args as the
# container command.
