#!/bin/sh
#
# Drop the removed desktop entry and icon from the shared caches.
#
# Per-user data is deliberately left alone even on purge: the extensions dir
# (marketplace installs), layouts and settings live under the user's home, are
# not owned by this package, and a user removing the package to install a newer
# one must not lose them.
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
  fi
fi

exit 0
