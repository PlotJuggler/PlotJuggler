{
  "name": "plotjuggler-wasm-browser-tests",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chromium --reporter=line --grep-invert @serial",
    "test:serial": "playwright test --project=chromium --reporter=line --workers=1 --grep @serial",
    "test:firefox": "playwright test --project=firefox --reporter=line --workers=1",
    "test:deployment": "playwright test -c deployment.playwright.config.js",
    "test:package": "node --test package_wasm.test.mjs wasm_notices.test.mjs wasm_source_offer.test.mjs",
    "fetch:assets": "node support/hosted_assets.js",
    "test:scene3d-capability": "playwright test -c scene3d_capability.playwright.config.js --project=chromium",
    "test:scene3d-capability:firefox": "playwright test -c scene3d_capability.playwright.config.js --project=firefox"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
