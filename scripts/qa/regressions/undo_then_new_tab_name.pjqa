# A tab added after an undo gets a new default name, not the one an open tab already shows.
# Tab bar, left to right: Signals (x 0..80), then each added tab (64 px), then "+" (31 px); offscreen geometry is fixed.
# app: -d tests/wasm/fixtures/signals/data.csv -l tests/wasm/fixtures/signals/layout.pj4.xml
# needs: plugins
until ui_plot {"title":"Periodic"} "x":["0.000","1000.000"]
ui_click {"name":"plotTabsInner","x":95,"y":15,"wait_ms":500}
ui_tree {}
expect QLabel "tab1"
ui_click {"name":"plotTabsInner","x":40,"y":15,"wait_ms":500}
until ui_plot {"title":"Periodic"} "x":["0.000","1000.000"]
ui_drag {"name":"tabbedPlotWidget","from":[100,520],"to":[250,700],"wait_ms":600}
ui_key {"keys":"Ctrl+Z","wait_ms":700}
until ui_plot {"title":"Periodic"} "x":["0.000","1000.000"]
ui_click {"name":"plotTabsInner","x":158,"y":15,"wait_ms":500}
ui_tree {}
expect QLabel "tab2"
