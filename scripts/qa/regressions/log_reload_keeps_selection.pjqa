# Intended behaviour (pj_log ARCHITECTURE, LogView): reloading the file keeps the Log panel's selected entry selected
# and the list on the playhead, although the reload refills the topic from empty.
# app: -d scripts/qa/regressions/fixtures/log_panel/rosout_a.mcap -l scripts/qa/regressions/fixtures/log_panel/rosout_a.pj4.xml
# needs: plugins
until ui_tree {} "0.000 | Info | node_a"
playback {"action":"seek","time_s":30}
until ui_tree {} "29.500 | Error | node_a"
ui_click {"name":"logView","x":30,"y":40}
ui_key {"keys":"End"}
ui_key {"keys":"Up"}
ui_key {"keys":"Up"}
ui_key {"keys":"Up"}
ui_key {"keys":"Up"}
until ui_tree {} #detailText "Time: 27.500
reload_file {"dataset":"rosout_a.mcap"}
expect "reloaded":true
until ui_tree {} #detailText "Time: 27.500
# The list shows the playhead's row, not the start of the log.
expect "29.500 | Error | node_a"
absent row "0.000 |
