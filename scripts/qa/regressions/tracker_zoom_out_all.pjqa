# The tracker's value box follows the zoom: hidden while its time is out of view, back with the values at that
# time after Zoom Out All, gone again on undo. Periodic is the lower plot of the signals layout.
# app: -d tests/wasm/fixtures/signals/data.csv -l tests/wasm/fixtures/signals/layout.pj4.xml
# needs: plugins
playback {"action":"seek","time_s":400}
ui_plot {"title":"Periodic"}
expect "tracker":["time : 400.000","1.000","1.000","0.000"]
# a box zoom over about 50..190 s, which leaves t=400 out
ui_drag {"name":"tabbedPlotWidget","from":[100,520],"to":[250,700],"wait_ms":600}
ui_plot {"title":"Periodic"}
expect "tracker":[]
absent "x":["0.000","1000.000"]
ui_click {"name":"buttonZoomOut","wait_ms":400}
ui_plot {"title":"Periodic"}
expect "tracker":["time : 400.000","1.000","1.000","0.000"],"x":["0.000","1000.000"]
ui_key {"keys":"Ctrl+Z","wait_ms":700}
ui_plot {"title":"Periodic"}
expect "tracker":[]
ui_key {"keys":"Ctrl+Shift+Z","wait_ms":700}
ui_plot {"title":"Periodic"}
expect "tracker":["time : 400.000","1.000","1.000","0.000"],"x":["0.000","1000.000"]
