# The tracker's value box follows the zoom: hidden while its time is out of view, back with the values at that
# time after Zoom Out All, gone again on undo. Periodic is the lower plot of the signals layout. `-d` takes the
# layout's CSV configuration, so the X axis is the file's time column (0..20 s).
# app: -d tests/wasm/fixtures/signals/data.csv -l tests/wasm/fixtures/signals/layout.pj4.xml
# needs: plugins
until ui_plot {"title":"Periodic"} "x":["0.000","20.000"]
playback {"action":"seek","time_s":8}
until ui_plot {"title":"Periodic"} "tracker":["time : 8.000","1.000","1.000","0.000"]
# a box zoom over about 1.0..3.8 s, which leaves 8 s out
ui_drag {"name":"tabbedPlotWidget","from":[100,520],"to":[250,700],"wait_ms":600}
ui_plot {"title":"Periodic"}
expect "tracker":[]
absent "x":["0.000","20.000"]
ui_click {"name":"buttonZoomOut","wait_ms":400}
until ui_plot {"title":"Periodic"} "tracker":["time : 8.000","1.000","1.000","0.000"],"x":["0.000","20.000"]
ui_key {"keys":"Ctrl+Z","wait_ms":700}
until ui_plot {"title":"Periodic"} "tracker":[]
ui_key {"keys":"Ctrl+Shift+Z","wait_ms":700}
until ui_plot {"title":"Periodic"} "tracker":["time : 8.000","1.000","1.000","0.000"],"x":["0.000","20.000"]
