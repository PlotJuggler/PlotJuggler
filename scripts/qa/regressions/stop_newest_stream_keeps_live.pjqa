# Two streams run; stopping the newer one leaves the older one followed live: playback keeps playing instead of
# freezing the cursor. Needs the Dummy Streamer plugin.
# app:
# needs: plugins
until get_status {} "stream_sources"
start_stream {"source":"Dummy Streamer"}
start_stream {"source":"Dummy Streamer"}
until get_status {} Dummy Streamer (2)
get_status {}
expect "playing":true
stop_stream {"dataset":2}
get_status {}
expect "playing":true
