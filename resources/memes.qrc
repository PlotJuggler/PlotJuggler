<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/resources">
    <!-- Funny splashscreen pool. The startup splash enumerates this directory
         at runtime (QDir(":/resources/memes")), so adding a meme is a pure
         resource change: drop meme_NN.jpg here and list it below. Desktop only: the
         browser build leaves this file out, and its splash is the serious one. -->
