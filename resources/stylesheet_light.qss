//------- PALETTE START --------
// Theme palette — every QSS value should reference a token here.
// Hard-coded hex / rgba / px values in the body are a smell; promote
// them to a token before re-using them in a second rule. See
// resources/visual_guidelines.md for the canonical reference.

theme: light

// ---- Backgrounds ---------------------------------------------------
// Fill colour for input chrome (PJ::ComboBox, DoubleScrubber). White so
// the input rectangle reads as a chart-surface inset; ScrubberBase
// uses the same value in C++ to stay in lockstep with the QComboBox QSS.
// Floating "toast" notification card. Needs its own solid fill because
// widget_background is transparent; a clean white card over the grey body.
// Theme-agnostic — the plotting canvas, the Qwt internal canvas, and
// the per-tab strip frames in TabbedPlotWidget all paint this colour
// so the plot area reads as a flat white surface in both themes.

// ---- Text ----------------------------------------------------------

// ---- Borders -------------------------------------------------------

// ---- Selections ----------------------------------------------------
// Text painted on top of `item_selection_background` in views (tables,
// trees, lists, file-dialog sidebar). Stays dark in both themes because
// the highlight fill is light/mid blue and reads better with dark ink
// than with the theme's regular default_text.

// ---- Brand accent colors (theme-agnostic, same in both stylesheets) ----

// ---- Status accents (used by marketplace cards + status banners) ---
// Theme-agnostic — these read the same against either chrome shade.

// ---- Marketplace card surface (theme-relative) ---------------------

// ---- Hover / pressed overlays --------------------------------------
// Translucent ink applied on top of a widget's background. In light
// theme this is black-with-alpha; the dark stylesheet inverts to
// white-with-alpha so the overlay always reads as "darker on hover,
// even darker when pressed" relative to the underlying surface.

// ---- Scrollbar / slider tones -------------------------------------

// ---- MessageBox per-theme overrides --------------------------------
// See stylesheet_dark.qss for the rationale.

// ---- Chrome geometry (in pixels, no `px` suffix) -------------------
// Every horizontal chrome row (TitleBar, Sources / Datasets / Custom
// Series headers, Tab strip, Playback, RHS column width) is exactly
// this tall. The tab strip itself is 1 px shorter because it carries
// a sibling separator that brings the total to chrome_bar_height.
chrome_bar_height:        24
chrome_tab_strip_height:  23

// 24 = flush button that fills a chrome row top-to-bottom (used in
// Sources / Datasets / Custom Series headers, RHS toolbar, Playback).
// 23 = inset button that fits inside a chrome row that draws its own
// 1-px border-bottom (used in TitleBar + dialogTitleBar).
chrome_button_size:        24
chrome_button_size_inset:  23

// Icon ink size inside every chrome button across the app.
chrome_icon_size:          20

// Horizontal gap between icon buttons sitting in the same chrome row.
chrome_spacing:            4

// All chrome borders that separate adjacent surfaces.
chrome_border_width:       1

// Corner radius for input chrome (PJ::ComboBox closed + open, DoubleScrubber).
// Keep DoubleScrubber's ScrubberBase::kCornerRadiusPx in lockstep.

// Single source of truth for the compact input height. Every input widget
// resolves to `input_outer_height` (20px) outer:
//   * self-painted widgets (ScrubberBase, PJ::CheckButton, PJ::ColorPickerWidget)
//     have no QSS border/padding, so their min/max-height IS the outer height ->
//     pinned directly to input_outer_height.
//   * native widgets (QLineEdit, QAbstractSpinBox, PJ::ComboBox) carry a 1px
//     border and zero vertical padding, so their content height is
//     input_min_height = input_outer_height - 2 (the two borders).
// Retune the whole family from these two values (keep PJ::Style::kInputHeight,
// the no-stylesheet fallback, equal to input_outer_height).
input_min_height:          18
input_outer_height:        20

// ---- PJ::ProgressBar (the rounded "Loading …" bar) -----------------
// Thick near-black outline + white trough + light-blue rounded fill +
// dark centred caption. Scoped to PJ::ProgressBar so the plain
// QProgressBar in ProgressDialog keeps the default Fusion look.

// ============ FRAMEWORK TOKENS (resources/ui_framework.md) ==========
// Semantic surface roles + the interaction variantxstate grid. These are
// the authoritative UI-framework tokens and the single ground truth for
// framework colors; the legacy brand/overlay tokens above are being migrated
// onto them and will be removed. Self-painted (QPainter) widgets read these in
// C++ via pj_widgets FrameworkTokens.{h,cpp}, a reader over this palette that
// holds no values of its own; framework_tokens_test asserts every token the
// framework enums require is present and valid here.
// "Special" is not a token: compose it in a rule as a qlineargradient
// from ${accent_<state>} to ${highlight_<state>}.

// ---- Surfaces ----
banner:         #D6D6D6
backdrop:       #EBEBEB
data_backdrop:  #FFFFFF
input:          #F5F5F5
separation:     #ADADAD
banner_input:   #E0E0E0
scroll_handle:  #47A3FF
surface_transparent: transparent

// ---- Foreground / content ink ----
// `text` is a compatibility alias for `on_backdrop_default`.
text:                         #333333
// Surface ink: on_<surface>_<emphasis>.
on_banner_default:            #333333
on_banner_muted:              #747474
on_banner_disabled:           #666666
on_backdrop_default:          #333333
on_backdrop_muted:            #7E7E7E
on_backdrop_disabled:         #666666
on_data_backdrop_default:     #333333
on_data_backdrop_muted:       #888888
on_data_backdrop_disabled:    #666666
on_input_default:             #333333
on_input_muted:               #838383
on_input_disabled:            #666666
on_separation_default:        #111111
on_separation_muted:          #5F5F5F
on_separation_disabled:       #666666
on_banner_input_default:      #333333
on_banner_input_muted:        #787878
on_banner_input_disabled:     #666666
on_scroll_handle_default:     #111111
on_scroll_handle_muted:       #2C5A88
on_scroll_handle_disabled:    #666666

// Fill ink: on_<variant>_<state>. Near-black/near-white chosen per cell for WCAG
// contrast against the fill; absolute #000/#FFF only where #111111/#F0F0F0 cannot
// reach 4.5:1 on the current (pre-migration) fill.
on_neutral_nominal:           #111111
on_neutral_hovered:           #111111
on_neutral_checked:           #111111
on_neutral_pressed:           #111111
on_neutral_checked_hovered:   #111111
on_neutral_checked_pressed:   #111111
on_neutral_disabled:          #F0F0F0

on_accent_nominal:         #111111
on_accent_hovered:         #111111
on_accent_checked:         #111111
on_accent_pressed:         #111111
on_accent_checked_hovered: #111111
on_accent_checked_pressed: #111111
on_accent_disabled:        #F0F0F0

on_highlight_nominal:             #111111
on_highlight_hovered:             #111111
on_highlight_checked:             #111111
on_highlight_pressed:             #111111
on_highlight_checked_hovered:     #111111
on_highlight_checked_pressed:     #111111
on_highlight_disabled:            #F0F0F0

on_emphasis_nominal:           #111111
on_emphasis_hovered:           #111111
on_emphasis_checked:           #111111
on_emphasis_pressed:           #111111
on_emphasis_checked_hovered:   #FFFFFF
on_emphasis_checked_pressed:   #F0F0F0
on_emphasis_disabled:          #F0F0F0

// Special gradient ink: on_special_<state>.
on_special_nominal:           #111111
on_special_hovered:           #111111
on_special_checked:           #111111
on_special_pressed:           #111111
on_special_checked_hovered:   #111111
on_special_checked_pressed:   #111111
on_special_disabled:          #F0F0F0

// ---- Icons ----
icon_ink:       #333333
icon_ink_disabled:       #A3A3A3
// ---- Interaction grid: <variant>_<state> ----
neutral_nominal:          #E0E0E0
neutral_hovered:          #CCCCCC
neutral_checked:          #B8B8B8
neutral_pressed:          #B8B8B8
neutral_checked_hovered:  #A3A3A3
neutral_checked_pressed:  #999999
neutral_disabled:         #333333

accent_nominal:          #D6EBFF
accent_hovered:          #C2E0FF
accent_checked:          #99CCFF
accent_pressed:          #99CCFF
accent_checked_hovered:  #70B8FF
accent_checked_pressed:  #5CADFF
accent_disabled:         #333333

highlight_nominal:          #FFD6FF
highlight_hovered:          #FFC2FF
highlight_checked:          #FF99FF
highlight_pressed:          #FF99FF
highlight_checked_hovered:  #FF70FF
highlight_checked_pressed:  #FF5CFF
highlight_disabled:         #333333

emphasis_nominal:          #F5D33D
emphasis_hovered:          #F3CA16
emphasis_checked:          #C2A00A
emphasis_pressed:          #C2A00A
emphasis_checked_hovered:  #887007
emphasis_checked_pressed:  #615005
emphasis_disabled:         #333333

// ---- Outline / stroke + focus (stroke ink; Separation stays the fill role) ----
outline_default_rest:         #C0C0C0
outline_default_hovered:      #62C5FF
outline_default_focused:      #1177FF
outline_default_checked:      #1177FF
outline_default_disabled:     #D6D6D6

outline_interactive_rest:     #C0C0C0
outline_interactive_hovered:  #62C5FF
outline_interactive_focused:  #1177FF
outline_interactive_checked:  #1177FF
outline_interactive_disabled: #D6D6D6

outline_divider_rest:         #C0C0C0
outline_divider_hovered:      #62C5FF
outline_divider_focused:      #1177FF
outline_divider_checked:      #1177FF
outline_divider_disabled:     #D6D6D6

outline_gridline_rest:        #C0C0C0
outline_gridline_hovered:     #62C5FF
outline_gridline_focused:     #1177FF
outline_gridline_checked:     #1177FF
outline_gridline_disabled:    #D6D6D6

// ---- Overlay / alpha (state layers + veils; theme-inverted) ----
overlay_hover:    rgba(0, 0, 0, 40)
overlay_pressed:  rgba(0, 0, 0, 70)
overlay_selected: rgba(0, 0, 0, 60)
overlay_scrim:    rgba(0, 0, 0, 140)
overlay_hud:      rgba(0, 0, 0, 170)

// ---- Selection (fill + ink; distinct from interaction Checked) ----
selection_fill:      #C2DCFF
on_selection:        #000000
text_selection_fill: rgba(0, 0, 0, 60)
on_text_selection:   #111111

// ---- Elevated surfaces (raised/floating tier, parallel to the base 7) ----
surface_dialog:       #F5F5F5
surface_card:         #E0E0E0
surface_card_hover:   #D0D0D0
surface_toast:        #FFFFFF
surface_disabled:     #EEEEEE

// ---- Gradients (two-stop endpoint tokens) ----
gradient_accent_start:  #FFAEFF
gradient_accent_end:    #C2DCFF
gradient_brand_start:   #1177FF
gradient_brand_end:     #CC00CC

// ---- Status (semantic warning/success/error/info/neutral; theme-agnostic hues) ----
status_success:          #4CAF6E
status_warning:          #E6A817
status_warning_hovered:  #F0B820
status_error:            #D32F2F
status_info:             #148CD2
status_info_hovered:     #42A5F5
status_neutral:          #607D8B
// Per-status inks (WCAG): the warm/light hues need dark ink, error stays white.
on_status_success:       #111111
on_status_warning:       #111111
on_status_error:         #FFFFFF
on_status_info:          #111111
on_status_neutral:       #111111
status_error_surface:    #FFCCCC
on_status_error_surface: #7A1F1F

// ---- Destructive (close / remove actions) ----
destructive_ink:      #CC00CC
destructive_nominal:  #CC00CC
destructive_hovered:  #FFAEFF
destructive_pressed:  #CC00CC
// Per-state inks: the legible ink flips with the fill's luminance
// (#CC00CC wants white, the pale #FFAEFF hover wants dark).
on_destructive_nominal:  #FFFFFF
on_destructive_hovered:  #111111
on_destructive_pressed:  #FFFFFF

// ---- Progress indicators ----
progress_outline:    #1C1C1C
progress_track:      #FFFFFF
progress_indicator:  #A6D5F7
on_progress:         #111111

// ---- Controls (slider handle + scrollbar hover) ----
slider_handle_nominal:  #999999
slider_handle_hovered:  #99CCFF
slider_handle_pressed:  #5CADFF
slider_handle_disabled: #C7C7CC
scroll_handle_hovered:  #148CD2

// ---- Cancel action (msgbox) ----
cancel_nominal:  #C4C4C4
cancel_hovered:  #B0B0B0

// ---- Ink over overlays (foreground on Overlay::Hud) ----
on_overlay_hud:  #F7F7F7

// ---- Code editor content ink (background = data_backdrop) ----
on_code_editor:  #1E1E1E

// ---- Syntax highlighting (editor content semantics) ----
syntax_keyword:  #0000FF
syntax_number:   #098658
syntax_string:   #A31515
syntax_comment:  #008000
syntax_builtin:  #795E26

// ---- Contrast ink (theme-independent; guaranteed contrast over arbitrary gamut) ----
contrast_dark:   #000000
contrast_light:  #FFFFFF

// ---- Muted icon ink (tree-branch line assets; also baked into *_light/_dark.svg) ----
icon_ink_muted:  #454545

// ---- Diagnostic dev-only categorical palette (DebugUi widget-class outlines) ----
diag_fallback:          #888888
diag_main_window:       #FF3B30
diag_dialog:            #FF9500
diag_widget:            #FFD60A
diag_frame:             #CCCC00
diag_splitter:          #34C759
diag_splitter_handle:   #00B894
diag_tab_widget:        #00C7BE
diag_tab_pane:          #5AC8FA
diag_tab:               #007AFF
diag_menu_bar:          #5856D6
diag_menu_bar_item:     #6C5CE7
diag_menu:              #AF52DE
diag_menu_item:         #D63384
diag_tooltip:           #FF2D92
diag_line_edit:         #E91E63
diag_plain_text_edit:   #F06292
diag_text_browser:      #EC407A
diag_combo_box:         #AB47BC
diag_spin_box:          #7E57C2
diag_check_box:         #5C6BC0
diag_radio_button:      #42A5F5
diag_group_box:         #29B6F6
diag_label:             #26C6DA
diag_push_button:       #66BB6A
diag_list_view:         #9CCC65
diag_tree_view:         #D4E157
diag_header_section:    #FFEE58
diag_scroll_bar:        #FFA726
diag_scroll_handle:     #FF7043
diag_slider_groove:     #D84315
diag_slider_handle:     #BF360C
diag_slider_subpage:    #8D6E63
diag_plot_widget:       #EF5350
diag_qwt_plot:          #B71C1C
diag_title_bar:         #00BCD4
diag_title_bar_button:  #4DD0E1

// ---- Size / non-color axes (theme-agnostic; duplicated in both palettes) ----
space_none:                    0
space_tight:                   2
space_snug:                    4
space_comfortable:             8
space_section:                 16

size_input_min_height:         18
size_input_outer_height:       20

radius_square:                 0
radius_input:                  4
radius_card:                   6
radius_dialog:                 8
radius_pill:                   9999

stroke_hairline:               1
stroke_emphasis:               2

type_caption_family:           sans-serif
type_caption_size:             9
type_caption_weight:           400
type_body_family:              sans-serif
type_body_size:                10
type_body_weight:              400
type_title_family:             sans-serif
type_title_size:               12
type_title_weight:             600
type_heading_family:           sans-serif
type_heading_size:             14
type_heading_weight:           600

motion_fast:                   140
motion_base:                   180
motion_slow:                   300
motion_reveal_hold:            1200

//------- PALETTE END --------

QWidget {
  background: transparent;
  padding: ${space_none}px;
  color: ${text};
  font-size: 10pt;
}

QWidget:disabled{
  color: ${on_backdrop_disabled};
  background: ${surface_disabled};
}

PlotWidget {
    background: ${data_backdrop};
    border: none;
}

QMainWindow {
    background: ${backdrop};
}

QDialog {
    /* Use the same token as QMainWindow so frameless dialogs sit on
       the same shade as the app behind them rather than a slightly
       different one. */
    background: ${backdrop};
}

/* Frameless, no drop shadow, and the same backdrop as the app behind it — this
   hairline is the dialog's only edge. Deliberately not `QDialog`: a plugin's .ui
   root is itself a QDialog that QUiLoader embeds as a child widget, and a generic
   rule would box that content again inside this chrome. */
PJ--Dialog {
    border: 1px solid ${separation};
}

QLabel {
    color: ${text};
    background: transparent;
}

QLineEdit {
    color: ${on_input_default};
    background: ${input};
    border: 1px solid ${separation};
    border-radius: ${radius_input}px;
    padding-top: ${space_none}px;
    padding-bottom: ${space_none}px;
    padding-left: ${space_snug}px;
    padding-right: ${space_snug}px;
    min-height: ${size_input_min_height}px;
    max-height: ${size_input_min_height}px;
    /* Framework text-selection colors (same pair the canonical Search uses).
       Without these the Fusion palette's system blue leaks into every plain
       line edit (e.g. the DateRangePicker date fields). */
    selection-background-color: ${overlay_selected};
    selection-color: ${text};
}

/* Inputs react like the canonical Search frame: accent border on hover, the
   stronger accent on focus (focus wins — later rule, equal specificity). */
QLineEdit:hover {
    border: 1px solid ${accent_checked_hovered};
}
QLineEdit:focus {
    border: 1px solid ${accent_checked};
}

QLineEdit:disabled {
    color: ${on_input_disabled};
}

QTabWidget{
  background: ${surface_transparent};
  margin-left: ${space_comfortable}px;
}

QTabWidget::pane { /* The tab widget frame */
    border: none;
    background: ${surface_transparent};
    top: -1px;
    border-radius: ${radius_square}px;
    border-top-left-radius: 0px;
}

QTabWidget::right-corner {
    subcontrol-position: left bottom;
}

QTabWidget::tab-bar {
    left: 0;
}

/* Opt-in edge-to-edge tabs for layouts that own their surrounding spacing. */
QTabWidget[flush="true"] {
    margin: ${space_none}px;
    padding: ${space_none}px;
}
QTabWidget[flush="true"]::pane {
    margin: ${space_none}px;
    padding: ${space_none}px;
}
QTabWidget[flush="true"]::tab-bar {
    left: ${space_none}px;
}

QTabBar::tab {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    min-width: 10ex;
    min-height: 34px;
    padding: ${space_none}px;
    padding-right: ${space_comfortable}px;
    padding-left: ${space_comfortable}px;
    color: ${text};
    border-left: none;
    border-right: none;
    border-top: none;
}

QTabBar::tab:selected {
    background: ${surface_transparent};
}
QTabBar::tab:!selected {
    background: transparent;
    border-bottom: none;
}

/* Opt-in "framed" tab look: a QTabWidget that sets the dynamic property
   framed="true" gets a bordered pane + bordered tabs (plugin dialogs:
   Transform Editor, MQTT, ULog). Single source of truth so the style isn't
   duplicated per .ui; the app's own tab strips stay flat (they don't set it).
   The [framed] attribute selector outranks the base rules above. */
QTabWidget[framed="true"]::pane {
    border: 1px solid ${separation};
    border-radius: ${radius_square}px;
    border-top-left-radius: 0px;
    top: -1px;
}
QTabWidget[framed="true"] QTabBar::tab {
    border: 1px solid ${separation};
    border-bottom: none;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    padding: ${space_snug}px ${space_section}px;
}
QTabWidget[framed="true"] QTabBar::tab:selected {
    background: ${backdrop};
}
QTabWidget[framed="true"] QTabBar::tab:!selected {
    background: transparent;
    border-bottom: 1px solid ${separation};
}

/* Chart-tab look for panels that are BOTH flush and framed (e.g. the Transform
   Editor): keep the slight per-tab border but drop the body/pane border, and
   mark the active tab with the checked accent — matching #plotTabFrame. Scoped by
   the two-attribute selector so single-`framed` plugin dialogs are untouched. */
QTabWidget[flush="true"][framed="true"]::pane {
    border: none;
}
QTabWidget[flush="true"][framed="true"] QTabBar::tab:selected {
    background: ${accent_checked};
}

QTextBrowser {
   background: ${surface_transparent};
   color: ${text};
}

QTextEdit,
QPlainTextEdit {
   background: ${surface_transparent};
   color: ${text};
   border-radius: ${radius_square}px;
   border: none;
}

/* Code editors (Lua / Python) use a light-theme syntax highlighter (dark-on-
   white token colors), so the text area stays white with dark ink. Tagged via
   the dynamic property _pj_code_editor in pj_dialog_host's widget binding. */
QPlainTextEdit[_pj_code_editor="true"] {
   background: ${data_backdrop};
   color: ${on_code_editor};
}

/* The pane wrapping a code editor (assist dropdowns + labels around it) shares
   the same white surface, so the whole editor block reads as one. Tagged
   _pj_code_editor_pane alongside the editor in the widget binding. */
QWidget[_pj_code_editor_pane="true"] {
   background: ${data_backdrop};
}

QToolTip {
    border: 1px solid ${separation};
    border-radius: ${radius_square}px;
    background-color: ${backdrop};
    color: ${text};
    padding: ${space_tight}px ${space_snug}px;
}

/* QScrollArea ------------------------------------------------------------

--------------------------------------------------------------------------- */

/* QScrollBar -------------------------------------------------------------

Thin flat bars: transparent track, rounded 6px pill handle, no step buttons.
Native bars stay visible only where pill adoption skips them (an axis pinned
AlwaysOn, combo-box popup lists); everywhere else attachPillScrollbars() blanks
the bar ([pjPillBar]) and the PJ::Scrollbar overlay paints the fading pill in
the gutter the bar still reserves — so scrollbars never cover content.

--------------------------------------------------------------------------- */
QScrollBar {
  background-color: ${surface_transparent};
  border: none;
}

QScrollBar:horizontal {
  height: 12px;
}

QScrollBar:vertical {
  width: 12px;
}

QScrollBar::handle {
  background-color: ${scroll_handle};
  border: none;
  border-radius: 3px;
}

QScrollBar::handle:hover {
  background-color: ${scroll_handle_hovered};
}

QScrollBar::handle:horizontal {
  min-width: 28px;
  margin: 3px 0px;
}

QScrollBar::handle:vertical {
  min-height: 28px;
  margin: 0px 3px;
}

/* No step buttons; their track slots collapse so the handle spans the bar. */
QScrollBar::add-line, QScrollBar::sub-line {
  width: 0px;
  height: 0px;
  border: none;
  background: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
  background: none;
}

/* A gutter bar adapted by attachPillScrollbars(): keeps its layout slot and
   native interaction but paints nothing — the pill overlay is its visual.
   Margins off so the whole gutter width stays a grabbable native handle. */
QScrollBar[pjPillBar="true"]::handle,
QScrollBar[pjPillBar="true"]::handle:hover {
  background-color: ${surface_transparent};
  margin: 0px;
}

/* The square where a horizontal and a vertical bar meet: paint nothing, like
   the rest of the gutter (unstyled it shows through as a light box). */
QAbstractScrollArea::corner {
  background: transparent;
  border: none;
}

/* QMenu ----------------------------------------------------------- */

/* QMenu rules use the #PJMenu id selector — id+type beats the cascading
   QWidget {background: transparent} rule that otherwise wins for popups
   when the stylesheet is applied via qApp->setStyleSheet. Tag any new
   menu with `setObjectName("PJMenu")` to opt into this styling. */

QMenu#PJMenu {
    background: ${backdrop};
    background-color: ${backdrop};
    color: ${text};
    border: 1px solid ${separation};
    padding: ${space_none}px;
}

QMenu#PJMenu::icon {
    padding-left: ${space_none}px;
}

QMenu#PJMenu::item {
    background-color: transparent;
    /* top, right, bottom, left — left is minimal so the icon hugs
       the menu's left edge; right keeps a breathing margin. */
    padding: ${space_snug}px ${space_section}px ${space_snug}px ${space_comfortable}px;
    color: ${text};
    border: none;
    margin: ${space_none}px;
}

QMenu#PJMenu::item:selected {
    background-color: ${accent_checked};
    color: ${on_accent_checked};
}

QMenu#PJMenu::item:checked {
    /* status_info is a readable accent-blue INK in both themes; accent_nominal
       is an interaction FILL (a pale background tone in light) and disappears
       when used as text. */
    color: ${status_info};
}

QMenu#PJMenu::item:disabled {
    color: ${on_backdrop_disabled};
}

QMenu#PJMenu::separator {
    height: 0px;
    background-color: transparent;
    margin: ${space_none}px;
}

QMenu#PJMenu[categorySeparators="true"]::separator {
    height: 1px;
    background-color: ${separation};
    margin: ${space_snug}px ${space_comfortable}px;
}

QMenu#PJMenu::right-arrow {
    image: url(":/resources/svg/keyboard_arrow_right_light.svg");
    width: 12px;
    height: 12px;
    margin-right: ${space_snug}px;
}

QMenu#PJMenu::indicator {
    width: 0px;
    height: 0px;
    image: none;
}

/* Push buttons hosted inside PJMenu (e.g. destructive-action items via
   QWidgetAction). No state paints an accent border; hover uses the shared
   secondary interaction fill. */
QMenu#PJMenu QPushButton,
QMenu#PJMenu QPushButton:focus,
QMenu#PJMenu QPushButton:pressed,
QMenu#PJMenu QPushButton:checked {
    background: transparent;
    border: none;
    outline: none;
    padding: ${space_snug}px ${space_section}px ${space_snug}px ${space_comfortable}px;
    text-align: left;
    border-radius: ${radius_square};
}

/* Destructive menu items (Cancel/Delete/Clear...) get purple text
   in both themes. Lives at the QSS level so the inline button
   stylesheet only has to set the `destructive` property — no
   hardcoded colour duplicated per call-site. */
QMenu#PJMenu QPushButton[destructive="true"] {
    color: ${destructive_nominal};
}

/* QCheckBox embedded in PJMenu (e.g. "Show Values"): match the
   QPushButton padding so its leading edge aligns with the icon
   column of neighbouring button items. The indicator's default
   margin-left is zeroed so the indicator itself sits at the
   item's padding-left, not 4px further in. */
QMenu#PJMenu QCheckBox {
    padding: ${space_snug}px ${space_section}px ${space_snug}px ${space_comfortable}px;
}

QMenu#PJMenu QCheckBox::indicator {
    margin-left: ${space_none}px;
}

QMenu#PJMenu QPushButton:hover {
    background: ${accent_hovered};
    color: ${on_accent_hovered};
    border: none;
    outline: none;
}

/* Destructive / negative-action buttons (Cancel, Delete, Clear, etc.)
   opt in via `setProperty("destructive", true)`. Hover uses the error
   interaction fill. Applies inside or outside a QMenu — the second selector is
   just for specificity over the PJMenu QPushButton:hover rule above. */
QPushButton[destructive="true"]:hover,
QMenu#PJMenu QPushButton[destructive="true"]:hover {
    background: ${destructive_hovered};
    border: none;
    outline: none;
}

/* QAbstractSpinBox -------------------------------------------------------

--------------------------------------------------------------------------- */
QAbstractSpinBox {
  background-color: ${input};
  border: 1px solid ${separation};
  color: ${on_input_default};
  padding-top: ${space_none}px;
  padding-bottom: ${space_none}px;
  padding-left: ${space_snug}px;
  padding-right: ${space_snug}px;
  border-radius: ${radius_input}px;
  min-height: ${size_input_min_height}px;
  max-height: ${size_input_min_height}px;
}

QAbstractSpinBox:up-button {
  background-color: transparent;
  subcontrol-origin: border;
  subcontrol-position: top right;
  border: none;
  margin: ${space_none}px;
}

QAbstractSpinBox::up-arrow,
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off,
QAbstractSpinBox::up-arrow:hover {
  image: url(":/resources/svg/keyboard_arrow_up_light.svg");
  height: 12px;
  width: 12px;
}

QAbstractSpinBox:down-button {
  background-color: transparent;
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  border: none;
  margin: ${space_none}px;
}

QAbstractSpinBox::down-arrow,
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off,
QAbstractSpinBox::down-arrow:hover {
  image: url(":/resources/svg/keyboard_arrow_down_light.svg");
  height: 12px;
  width: 12px;
}

QAbstractSpinBox:hover,
QAbstractSpinBox:focus {
  border: 1px solid ${separation};
}

/* QRadioButton ----------------------------------------------------------- */

QRadioButton{
    color: ${text};
    background-color: transparent;
    spacing: ${space_none}px;
    padding: ${space_none}px;
    border: none;
    outline: none;
}

QRadioButton:disabled {
    color: ${on_backdrop_disabled};
}

QRadioButton::indicator {
    border: none;
    outline: none;
    margin-bottom: ${space_tight}px;
    width: 25px;
    height: 25px;
}

QRadioButton::indicator:unchecked {
    image: url(:/resources/svg/radio_unchecked_light.svg);
}

QRadioButton::indicator:checked {
    image: url(:/resources/svg/radio_checked_light.svg);
}

QRadioButton::indicator:checked:disabled {
    image: url(:/resources/svg/radio_checked_disabled_light.svg);
}

QRadioButton::indicator:unchecked:disabled {
    image: url(:/resources/svg/radio_unchecked_disabled_light.svg);
}

/* QCheckBox -------------------------------------------------------------- */

QCheckBox{
   background-color: transparent;
   color: ${text};
}

QCheckBox::indicator {
    margin-left: ${space_snug}px;
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(:/resources/svg/checkbox_unchecked_light.svg);
}

QCheckBox::indicator:unchecked:disabled {
    image: url(:/resources/svg/checkbox_unchecked_disabled_light.svg);
}

QCheckBox::indicator:checked {
    image: url(:/resources/svg/checkbox_checked_light.svg);
}

QCheckBox::indicator:checked:disabled {
    image: url(:/resources/svg/checkbox_checked_disabled_light.svg);
}

/* QGroupBox -------------------------------------------------------------- */

QGroupBox{
    margin-top: ${space_comfortable}px;
    padding-top: ${space_section}px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding-bottom: ${space_comfortable}px;
    font-weight: 600;
}

QGroupBox::indicator {
    margin-left: ${space_snug}px;
    width: 16px;
    height: 16px;
}

QGroupBox::indicator {
    margin-left: ${space_tight}px;
}

QGroupBox::indicator:unchecked {
    image: url(:/resources/svg/checkbox_unchecked_light.svg);
}

QGroupBox::indicator:checked {
    image: url(:/resources/svg/checkbox_checked_light.svg);
}

QGroupBox::indicator:checked:disabled {
    image: url(:/resources/svg/checkbox_checked_disabled_light.svg);
}

QGroupBox::indicator:unchecked:disabled {
    image: url(:/resources/svg/checkbox_unchecked_disabled_light.svg);
}

/* QPushButton -------------------------------------------------------------- */

QPushButton
{
    color: ${text};
    border-radius: ${radius_input}px;
    padding: ${space_comfortable}px;
    outline: none;
}

QPushButton[flat="true"]
{
    background: transparent;
    border: none;
}

/* A solid button IS the Primary interaction variant (fill per state), never a
   bordered box. Separation is only for dividers between objects, not buttons. */
QPushButton[flat="false"]
{
    background: ${neutral_nominal};
    border: none;
    color: ${on_neutral_nominal};
}

QPushButton[flat="false"]:hover {
    background: ${neutral_hovered};
    color: ${on_neutral_hovered};
}

QPushButton[flat="false"]:pressed {
    background: ${neutral_pressed};
    color: ${on_neutral_pressed};
}

/* Extension-detail dialog action buttons: their per-widget .ui styleSheet can't
   reference the radius_* tokens, so the corner radius comes from the token here (the ID
   selector outranks the .ui's type selector, which keeps only its border/padding). */
QPushButton#github_btn,
QPushButton#uninstall_btn,
QPushButton#close_btn {
    border-radius: ${radius_input}px;
}

QPushButton:disabled {
    color: ${on_backdrop_disabled};
}

QPushButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    bottom: 4px;
}

/* Consistent state feedback. Hover / pressed are neutral darken
   overlays; the active "selected" states (checked) use the same
   ${accent_checked} tone as tree-view selections so all
   "this is the active thing" indicators read identically. */
QPushButton:hover {
    background: ${overlay_hover};
}

QPushButton:pressed {
    background: ${overlay_pressed};
}

QPushButton:checked {
    background: ${accent_checked};
    color: ${on_accent_checked};
}

QPushButton:checked:hover {
    background: ${accent_checked};
}

QPushButton:checked:disabled {
    color: ${on_backdrop_disabled};
}

/* QToolButton ----------------------------------------------------------- */
/* Explicit rules pre-empt the platform fallback paint, which on some */
/* Linux desktops lights up the whole button area in palette(highlight) */
/* — a brown wash that visually wipes the icon. */

QToolButton {
    background: transparent;
    border: none;
    border-radius: ${radius_input}px;
    color: ${text};
    padding: ${space_none}px;
}

QToolButton:hover {
    background: ${overlay_hover};
}

QToolButton:pressed {
    background: ${overlay_pressed};
}

QToolButton:checked {
    background: ${accent_checked};
}

/* Datasets type-filter toggles convey state through the icon (plain vs. dimmed +
   slashed), not a checked fill — so the all-shown default stays visually calm. */
QToolButton#buttonFilterPlot:checked,
QToolButton#buttonFilterScene2D:checked,
QToolButton#buttonFilterScene3D:checked {
    background: transparent;
}

QToolButton:disabled {
    background: transparent;
    color: ${on_backdrop_disabled};
}

/* Curve-editor per-row inline buttons (markers toggle, visibility eye,
   trash): kept flat in every state so the icons read as plain ink glyphs,
   no hover / checked / pressed wash. */
QToolButton#curveVisibilityToggle,
QToolButton#curveVisibilityToggle:hover,
QToolButton#curveVisibilityToggle:pressed,
QToolButton#curveVisibilityToggle:checked,
QToolButton#curveMarkersToggle,
QToolButton#curveMarkersToggle:hover,
QToolButton#curveMarkersToggle:pressed,
QToolButton#curveMarkersToggle:checked,
QToolButton#curveTrashToggle,
QToolButton#curveTrashToggle:hover,
QToolButton#curveTrashToggle:pressed,
QToolButton#scene3dRobotRowTrash,
QToolButton#scene3dRobotRowTrash:hover,
QToolButton#scene3dRobotRowTrash:pressed {
    background: transparent;
    border: none;
}

/* Curve-editor line-style frame: when no curve is selected the frame is
   disabled, which would otherwise pick up the generic QWidget:disabled
   light-gray wash. Keep it transparent so the chrome stays clean. */
QFrame#frameStyle,
QFrame#frameStyle:disabled {
    background: transparent;
}

/* Curve-editor line-style selector: the six mutually-exclusive style
   icons stay flat in every state so the row reads as a strip of plain
   glyphs, no blue wash on the active button. */
QToolButton#radioLines,
QToolButton#radioLines:hover,
QToolButton#radioLines:pressed,
QToolButton#radioLines:checked,
QToolButton#radioDots,
QToolButton#radioDots:hover,
QToolButton#radioDots:pressed,
QToolButton#radioDots:checked,
QToolButton#radioLinesAndDots,
QToolButton#radioLinesAndDots:hover,
QToolButton#radioLinesAndDots:pressed,
QToolButton#radioLinesAndDots:checked,
QToolButton#radioSticks,
QToolButton#radioSticks:hover,
QToolButton#radioSticks:pressed,
QToolButton#radioSticks:checked,
QToolButton#radioSteps,
QToolButton#radioSteps:hover,
QToolButton#radioSteps:pressed,
QToolButton#radioSteps:checked,
QToolButton#radioStepsInverted,
QToolButton#radioStepsInverted:hover,
QToolButton#radioStepsInverted:pressed,
QToolButton#radioStepsInverted:checked {
    background: transparent;
    border: none;
}

/* QCombobox -------------------------------------------------------------- */

/* Closed combobox chrome — mirrors DoubleScrubber's painted chrome. */
QComboBox {
    color: ${on_input_default};
    background: ${input};
    selection-color: ${on_accent_checked};
    border: 1px solid ${separation};
    border-radius: ${radius_input}px;
    padding-top: ${space_none}px;
    padding-bottom: ${space_none}px;
    padding-left: ${space_snug}px;
    /* Right gutter reserves the chevron region. Keep it == the ::drop-down
       width so the text ends exactly at the drop-down edge (no overlap, no dead
       space). This width also feeds sizeFromContents, so a tighter value makes
       every combo hug its widest item instead of carrying a fat right margin. */
    padding-right: ${space_section}px;
    min-height: ${size_input_min_height}px;
    max-height: ${size_input_min_height}px;
}

QComboBox:hover,
QComboBox:focus {
    border: 1px solid ${separation};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
    border: none;
    background: transparent;
}

/* Disclosure affordance: the chevron points RIGHT while the popup is closed
   and flips DOWN (:on) while it's open. */
QComboBox::down-arrow {
    image: url(:/resources/svg/keyboard_arrow_right_light.svg);
    width: 14px;
    height: 14px;
}

QComboBox::down-arrow:on {
    image: url(:/resources/svg/keyboard_arrow_down_light.svg);
}

/* Popup — rounded surface + 1 px border. The accent gradient on
   selected/hovered items is painted by the
   PJ::ComboBoxGradientDelegate in C++; Qt's QSS engine doesn't honour
   gradient backgrounds on QComboBox popup items (they go through
   QPalette::Highlight, which only carries a solid colour). */
/* Popup container (QComboBoxPrivateContainer) — Qt's default QFrame paint
   draws a 1-px outline that lands on top of the inner view's QSS border,
   reading as a double line at the corners. Force a fully transparent
   container so the view's border-radius is the only visible edge. */
QComboBoxPrivateContainer {
    background: transparent;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: ${backdrop};
    border: 1px solid ${separation};
    border-radius: ${radius_input}px;
    color: ${text};
    outline: none;
    padding-top: ${space_snug}px;
    padding-bottom: ${space_snug}px;
    padding-left: ${space_none}px;
    padding-right: ${space_none}px;
    margin: ${space_none}px;
}

QComboBox QAbstractItemView::viewport {
    background-color: ${backdrop};
}

/* QSlider ---------------------------------------------------------------- */

QSlider:disabled {
    background: ${surface_disabled};
}

QSlider:focus {
    border: none;
}

QSlider::groove:horizontal {
    background: ${surface_transparent};
    border: none;
    height: 8px;
    margin: ${space_none}px;
    border-radius: ${radius_square}px;
}

QSlider::sub-page:horizontal {
    background: ${accent_nominal};
    border: none;
    height: 4px;
    margin: ${space_none}px;
    border-radius: ${radius_square}px;
}

QSlider::sub-page:horizontal:disabled {
    background: ${surface_disabled};
}

QSlider::handle:horizontal {
    background: ${slider_handle_nominal};
    border: none;
    width: 8px;
    height: 8px;
    margin: -${space_snug}px ${space_none}px;
    border-radius: ${radius_square}px;
}

QSlider::handle:horizontal:hover {
    background: ${slider_handle_hovered};
    border: none;
}

/* Grabbed: the handle deepens while it is being dragged, so the control
   confirms the grab the same way the playback handle and QSplitter handles do. */
QSlider::handle:horizontal:pressed {
    background: ${slider_handle_pressed};
    border: none;
}

QSlider::handle:horizontal:disabled {
    background: ${slider_handle_disabled};
    border: none;
}

/* Vertical sliders mirror the horizontal rules above. Without these the whole
   control renders unstyled — Qt falls back to the native style, which under the
   app stylesheet paints nothing at all. The filled span is add-page because a
   vertical QSlider puts its minimum at the bottom. */
QSlider::groove:vertical {
    background: ${surface_transparent};
    border: none;
    width: 8px;
    margin: ${space_none}px;
    border-radius: ${radius_square}px;
}

QSlider::add-page:vertical {
    background: ${accent_nominal};
    border: none;
    width: 4px;
    margin: ${space_none}px;
    border-radius: ${radius_square}px;
}

QSlider::add-page:vertical:disabled {
    background: ${surface_disabled};
}

QSlider::handle:vertical {
    background: ${slider_handle_nominal};
    border: none;
    width: 8px;
    height: 8px;
    margin: ${space_none}px -${space_snug}px;
    border-radius: ${radius_square}px;
}

QSlider::handle:vertical:hover {
    background: ${slider_handle_hovered};
    border: none;
}

QSlider::handle:vertical:pressed {
    background: ${slider_handle_pressed};
    border: none;
}

QSlider::handle:vertical:disabled {
    background: ${slider_handle_disabled};
    border: none;
}

/* 1-px separator between the playback bar (above) and the timeline
   strip (below). Painted as the strip's top border so the line is
   only visible when the strip itself is visible — folding the strip
   away (via the bottom-panel toggle) takes the divider with it
   rather than leaving a stray border at the window's bottom edge. */
QWidget#timelineStrip {
    border-top: 1px solid ${separation};
}

/* Playback slider spans the full 24-px chrome row top-to-bottom:
   groove and handle both fill the bar height (no margins / negative
   insets), so the body reads as a solid track and the handle as a
   tall narrow grip. */
QSlider#timeSlider::groove:horizontal {
    height: 24px;
    margin: ${space_none}px;
    background: ${surface_transparent};
    border: 1px solid ${separation};
    border-radius: ${radius_input}px;
}

QSlider#timeSlider::sub-page:horizontal {
    height: 24px;
    margin: ${space_none}px;
    background: ${accent_nominal};
    /* Darker-accent outline so the played fill reads as a defined bar against the
       lighter accent body. At value 0.0 the sub-page is 0-width, so it shows as a
       thin vertical sliver hugging the groove's left edge until playback advances
       — an accepted tradeoff. */
    border: 1px solid ${accent_checked};
    /* Only the LEFT corners round (nesting inside the groove's rounded start);
       the right edge stays square where it meets the rectangular handle. */
    border-top-left-radius: ${radius_input}px;
    border-bottom-left-radius: ${radius_input}px;
}

QSlider#timeSlider::sub-page:horizontal:disabled {
    background: ${accent_disabled};
    border: 1px solid ${accent_disabled};
}

/* Playback handle: highlight (magenta) family so the grip stands out against
   the accent-blue played track (sub-page) and reads as "the time control"
   distinct from any other slider. Rectangular — only the groove border
   carries the framework rounding. */
QSlider#timeSlider::handle:horizontal {
    width: 6px;
    height: 24px;
    margin: ${space_none}px;
    background: ${highlight_nominal};
    border: 1px solid ${separation};
}

QSlider#timeSlider::handle:horizontal:hover {
    background: ${highlight_hovered};
    border: 1px solid ${separation};
}

QSlider#timeSlider::handle:horizontal:pressed {
    background: ${highlight_pressed};
    border: 1px solid ${separation};
}

QSlider#timeSlider::handle:horizontal:disabled {
    background: ${highlight_disabled};
    border: 1px solid ${separation};
}

/* Extension-update affordance in the title bar (left of the notification bell):
   a recessed neutral chip — ${neutral_checked} fill sits one step DARKER than the
   ${banner} chrome so it reads as inset — with ${icon_ink} "Update" text so the
   label reads in the same ink as the neighbouring chrome icons. Height is pinned
   to the square chrome buttons' extent in TitleBar::applyIconMetrics (NOT capped
   here), so it fills the bar like its icon neighbours while still sizing its width
   to the text. Hidden until the startup registry scan finds an installed extension
   with a newer registry version. The two-id selector outranks the generic
   #TitleBar QToolButton chrome rules. */
#TitleBar QToolButton#buttonExtensionUpdate {
    background: ${neutral_checked};
    color: ${icon_ink};
    border: none;
    border-radius: ${radius_card}px;
    padding: 0px ${space_comfortable}px;
    font-weight: 600;
}

#TitleBar QToolButton#buttonExtensionUpdate:hover {
    background: ${neutral_checked_hovered};
    color: ${icon_ink};
}

/* --------------------------------------------------------------------------- */

/* Tables read as the data backdrop surface with a
   hairline border, like the Preferences lists — so a table separates from the
   dialog/page behind it instead of blending in. Applies to every QTableView /
   QTableWidget in the app and in plugin dialogs. */
QTableView {
   background: ${data_backdrop};
   alternate-background-color: ${data_backdrop};
   color: ${on_data_backdrop_default};
   border-radius: ${radius_square}px;
   border: 1px solid ${separation};

   selection-color: ${on_data_backdrop_default};
   selection-background-color: transparent;
   show-decoration-selected: 1;
}

/* Opt out of the table border for flush, header-banded tables (plugin panels
   that lead with a SectionHeaderBand and want the rows butting the band). */
QTableView[flush="true"] {
   border: none;
}

QTreeView,
QListView {
   background: ${data_backdrop};
   color: ${on_data_backdrop_default};
   border-radius: ${radius_square}px;
   border: none;

   selection-color: ${text};
   selection-background-color: transparent;
   show-decoration-selected: 1;
}

/* Cells must be painted with the same data backdrop surface as the viewport: Qt
   initializes QPalette::Base on QTableWidget to white regardless of the
   theme, and QStyledItemDelegate paints each item's background from that
   palette role, ignoring a `background: transparent` on ::item. Pin the
   colour explicitly so cells match the viewport ${data_backdrop}. */
QTableView::item,
QTableWidget::item {
   background-color: ${data_backdrop};
   color: ${on_data_backdrop_default};
}

/* Disabled tables / rows: grey the text. Without these, the unconditional
   ::item color above wins in EVERY state (QSS beats the palette), so neither a
   mode-disabled table (e.g. the topic table in "All" mode) nor per-row
   disabling (zero-count topic rows) had any visible cue. The selected:disabled
   pair also suppresses the selection highlight so a disabled table reads
   uniformly inert; ENABLED selected rows (incl. force-selected ones) keep the
   regular selection look from the rule below. */
QTableView::item:disabled,
QTableWidget::item:disabled {
   background-color: ${data_backdrop};
   color: ${on_data_backdrop_disabled};
}
QTableView::item:selected:disabled,
QTableWidget::item:selected:disabled {
   background-color: ${data_backdrop};
   color: ${on_data_backdrop_disabled};
}

QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
   background-color: ${accent_checked};
   color: ${on_accent_checked};
}

/* The widget itself owns the continuous bottom line so the divider
   extends past the rightmost section into any empty header strip when
   columns don't fill the available width. The per-section border-bottom
   below paints on top of this and stays in sync visually. */
QHeaderView {
    background-color: ${backdrop};
    border: none;
    border-bottom: 1px solid ${separation};
}

QHeaderView::section {
    background-color: ${backdrop};
    color: ${text};
    /* Non-bold: QTableWidget defaults its header font to bold, and a widget-side
       setFont(non-bold) is ignored while the app stylesheet is active, so force it
       here. */
    font-weight: normal;
    padding-left: ${space_snug}px;
    border: none;
    border-top: 1px solid ${separation};
    border-right: 1px solid ${separation};
}

QHeaderView::section:last,
QHeaderView::section:only-one {
    border-right: none;
}

QHeaderView::text{
    padding-left: ${space_snug}px;
    padding-right: ${space_snug}px;
}

QHeaderView::up-arrow {
    subcontrol-position: center right;
    image: url(:/resources/svg/keyboard_arrow_up_light.svg);
    height: 12px;
    width: 12px;
    padding-left: ${space_snug}px;
    padding-right: ${space_snug}px;
}

QHeaderView::down-arrow {
    subcontrol-position: center right;
    image: url(:/resources/svg/keyboard_arrow_down_light.svg);
    height: 12px;
    width: 12px;
    padding-left: ${space_snug}px;
    padding-right: ${space_snug}px;
}

QTreeView:branch {
    background-color: transparent;
}

QTreeView:branch:selected, QTreeView:branch:hover {
  background: transparent;
}

/* Branch indicators use the *_dark.svg variant (fill #454545) under the
   light theme so they read as a dark gray on the light tree background.
   The *_light.svg variant (fill #B8B8B8) is reserved for the dark theme. */
QTreeView:branch:has-siblings:!adjoins-item {
  border-image: url(":/resources/svg/branch_line_dark.svg") 0;
}

QTreeView:branch:has-siblings:adjoins-item {
  border-image: url(":/resources/svg/branch_more_dark.svg") 0;
}

QTreeView:branch:!has-children:!has-siblings:adjoins-item {
  border-image: url(":/resources/svg/branch_end_dark.svg") 0;
}

QTreeView:branch:has-children:!has-siblings:closed, QTreeView:branch:closed:has-children:has-siblings {
  border-image: none;
  image: url(":/resources/svg/keyboard_arrow_right_light.svg");
}

QTreeView:branch:open:has-children:!has-siblings, QTreeView:branch:open:has-children:has-siblings {
  border-image: none;
  image: url(":/resources/svg/keyboard_arrow_down_light.svg");
}

QSplitter {
  spacing: ${space_none}px;
  padding: ${space_none}px;
  margin: ${space_none}px;
}

/* Splitter handles are now thin 1px separator lines instead of icon
   drag-handles. Resize still works (you can grab the line) but the
   visual is just a divider. */
QSplitter::handle {
  background-color: ${separation};
  border: none;
  spacing: ${space_none}px;
  padding: ${space_none}px;
  margin: ${space_none}px;
  image: none;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* Canonical: an interactable separator lights up under the cursor, the same
   Highlight family the table-header dividers use, then deepens on grab below. */
QSplitter::handle:hover {
  background-color: ${highlight_hovered};
}

/* Canonical: an interactable separator, while grabbed/pressed, is the Highlight
   variant's Pressed color — everywhere. */
QSplitter::handle:pressed {
  background-color: ${highlight_pressed};
}

/* QMenuBar ---------------------------------------------------------------

Embedded in the TitleBar chrome (TitleBar.ui), so it stays transparent
and inherits the banner surface; items highlight with the same overlay
tones as the chrome buttons around them.

--------------------------------------------------------------------------- */
QMenuBar {
  background: transparent;
  color: ${text};
  border: none;
}

QMenuBar:focus {
  border: none;
}

QMenuBar::item {
  background: transparent;
  padding: ${space_snug}px ${space_snug}px;
  border-radius: ${radius_input}px;
}

QMenuBar::item:selected {
  background: ${overlay_hover};
  border: none;
}

QMenuBar::item:pressed {
  background: ${overlay_pressed};
  border: none;
}

/* ------------------------ Specific Widgets ------------------------ */

QWidget#leftMainWindowFrame
{
  background-color: ${backdrop};
}

/* The exporter's prefix field lives inside the Settings header band, so it wears
   the band's input tone — the same pair the canonical Search uses for its
   kBanner variant, not the standalone `input` surface. */
/* Same rest/hover/focus treatment as the canonical Search: a 1px border is
   always present (transparent at rest) so the two states only recolour it and
   the text never shifts. Focus wins over hover (later rule, equal specificity).
   The id selector outranks the global QLineEdit:hover/:focus rules, which would
   otherwise paint this field with the standalone-input border. */
QLineEdit#lineEditPrefix{
  background-color: ${banner_input};
  color: ${on_banner_input_default};
  border: 1px solid transparent;
  border-radius: ${radius_input}px;
  padding-left: ${space_snug}px;
  padding-right: ${space_snug}px;
}

QLineEdit#lineEditPrefix:hover{
  border: 1px solid ${accent_checked_hovered};
}

QLineEdit#lineEditPrefix:focus{
  border: 1px solid ${accent_checked};
}

QWidget#plottingArea{
  background-color: ${backdrop};
}

/* Both names: the widget authors itself as mediaViewerCanvas; the app's
   Scene2DDockWidget renames its instance to scene2dMediaViewer. The 2D media
   canvas is a DATA surface, matching the C++ constructor default. */
QWidget#mediaViewerCanvas,
QWidget#scene2dMediaViewer{
  qproperty-clearColor: ${data_backdrop};
}

QWidget#plottingArea QMenu{
  background-color: ${surface_transparent};
}

QFrame#framePlotPreview,
QFrame#framePlotPreviewA,
QFrame#framePlotPreviewB,
QFrame#framePlotPreviewC {
   background-color: ${surface_transparent};
   border: none;
   margin: ${space_none}px;
}

QWidget#formulaPage{
   background-color: ${backdrop};
}

ads--CDockContainerWidget {
  background: ${data_backdrop};
  border: none;
}

ads--CDockAreaWidget {
   background: ${data_backdrop};
   border: none;
}

ads--CDockWidget {
   background: ${data_backdrop};
   border: none;
}

QScrollArea#dockWidgetScrollArea {
   border: none;
}

QwtPlot {
   background: ${data_backdrop};
   border: none;
}

QWidget#qwtCanvas {
   background: ${data_backdrop};
   border: none;
}

QDialog#PlotWidgetEditor QListView::item:selected {
    background-color: ${backdrop};
}

/* Toast Notification ----------------------------------------------------- */

ToastNotification {
    background-color: ${surface_transparent};
    border: none;
    border-radius: ${radius_square}px;
    min-width: 250px;
    max-width: 400px;
}

ToastNotification QLabel#toastMessage {
    color: ${text};
    font-size: 10pt;
}

ToastNotification QLabel#toastIcon {
    background: transparent;
}

ToastNotification QPushButton#toastCloseButton {
    background: transparent;
    border: none;
    color: ${on_backdrop_disabled};
    font-size: 14pt;
    font-weight: 600;
    padding: ${space_none}px;
    margin: ${space_none}px;
}

ToastNotification QPushButton#toastCloseButton:hover {
    color: ${text};
}

/* ---------- Frameless chrome bars ---------- */
/* Every chrome row that draws its own bottom border (TitleBar +
   dialog title bars) shares this rule. Add the selector here rather
   than copy-pasting the background/border pair into a new block. */
#TitleBar,
QDialog QWidget#dialogTitleBar {
    background: ${banner};
    border-bottom: ${stroke_hairline}px solid ${separation};
}

/* Toolbox panel Banner header (MainWindow::wrapToolboxPanel): Surface::Banner
   with a far-left title and a far-right close button, mirroring the dialog
   title-bar chrome for docked toolboxes. */
QWidget#toolboxBanner {
    background: ${banner};
    border-bottom: ${stroke_hairline}px solid ${separation};
}
QLabel#toolboxBannerTitle {
    color: ${text};
    padding-left: ${space_tight}px;
}
QWidget#toolboxBanner QToolButton#buttonClose {
    background: transparent;
    border: none;
    padding: ${space_none}px;
}
QWidget#toolboxBanner QToolButton#buttonClose:hover {
    background: ${overlay_hover};
}
QWidget#toolboxBanner QToolButton#buttonClose:pressed {
    background: ${overlay_pressed};
}

/* Standalone 1-px separators painted at chrome boundaries that aren't
   covered by a widget's own border (timelineStrip top, plot tab strip
   bottom, splitter handles). All use the same ink. */
QFrame#timelineSeparator,
QFrame#plotTabsSeparator,
QFrame[separatorLine="true"] {
    background-color: ${separation};
}

/* Tab-strip chrome — flat white so the bar reads as part of the
   chart surface in light mode rather than the grey shell tone the
   dark stylesheet inherits via transparency. */
QWidget#plotTabsBar,
QWidget#plotTabsInner {
    background: ${data_backdrop};
    border: none;
}

/* Custom tab strip in TabbedPlotWidget. The active tab uses a
   `selected="true"` dynamic property so it stands out from the inactive
   peers without needing a different objectName per state. */
QFrame#plotTabFrame {
    background: ${data_backdrop};
    border: none;
    border-radius: ${radius_square}px;
    color: ${text};
}

QFrame#plotTabFrame[selected="true"] {
    background: ${accent_checked};
}

QFrame#plotTabFrame:hover {
    background: ${banner};
}

QLineEdit#plotTabRenameEdit {
    background: transparent;
    border: none;
    padding: ${space_none}px;
    selection-background-color: ${overlay_selected};
    selection-color: ${text};
}

/* Accordion-header bands in the LHS panels and the right-side
   CurveEditor "Curves" header share the title-bar tone; the code-built
   bands (Curve Width / Curve Style / 3D scene sections) are
   SectionHeaderBand widgets, themed by the class rule below. */
QWidget#widgetLabelInput,
QWidget#widgetLabelTimeseries,
QWidget#widgetLabelCustom,
QWidget#widgetLabelCurves,
QWidget#widgetLabelChart,
QWidget#widgetLabelLegend,
QWidget#timelineDatasetsHeader {
    background-color: ${banner};
}

/* Shared section-header widget (pj_widgets SectionHeaderBand): same band
   tone, themed once via the class selector — no per-instance objectName
   registration. The leading indent is baked into the widget. */
PJ--SectionHeaderBand {
    background-color: ${banner};
}

/* Canonical search/filter control (pj_widgets Search): the magnifying glass
   and the field share one flat background so they read as a single control. The
   default `kBanner` variant sits in a header band (banner_input tone); the
   `standalone` variant sits on its own surface (input tone, e.g. marketplace).
   The inner line edit + glyph buttons are transparent so the frame fill shows
   through as one seamless surface; the global QLineEdit height cap is lifted so
   the field fills the chrome-sized frame. */
PJ--Search {
    background: ${banner_input};
    /* A 1px border is always present (transparent at rest) so hover/focus only
       recolour it — the content never shifts. Hover/focus land on the WHOLE
       control via the pjHovered/pjFocused dynamic properties the widget sets in
       C++ (Qt QSS has no :focus-within, and a child's state doesn't reach the
       frame). Focus wins over hover (later rule, equal specificity). */
    border: 1px solid transparent;
    border-radius: ${radius_input}px;
}
PJ--Search[variant="standalone"] {
    background: ${input};
}
PJ--Search[pjHovered="true"] {
    border: 1px solid ${accent_checked_hovered};
}
PJ--Search[pjFocused="true"] {
    border: 1px solid ${accent_checked};
}
/* The inner field is borderless in every state — the global QLineEdit:hover/
   :focus rule (higher specificity than a bare descendant selector) would
   otherwise re-add its border, which is exactly what we're moving to the frame. */
PJ--Search QLineEdit,
PJ--Search QLineEdit:hover,
PJ--Search QLineEdit:focus {
    background: transparent;
    color: ${on_banner_input_default};
    border: none;
    padding: ${space_none}px;
    min-height: 0;
    max-height: 16777215;
    selection-background-color: ${overlay_selected};
    selection-color: ${text};
}
PJ--Search[variant="standalone"] QLineEdit {
    color: ${on_input_default};
}

/* Pill toggle (pj_widgets CheckButton): self-painted, so its colours come
   through Qt stylesheet qproperties. Checked reads as a "selected chip" using
   the same selection tokens as the rest of the app: accent border, light
   selection fill, dark selection label. */
PJ--CheckButton {
    qproperty-accentColor: ${separation};
    qproperty-borderColor: ${separation};
    qproperty-checkedFillColor: ${accent_checked};
    qproperty-textColor: ${text};
}

/* Two-option segmented control: self-painted, with a shared base and selected
   segment rendered as the active chip. */
PJ--DualOptionsWidget {
    qproperty-accentColor: ${separation};
    qproperty-borderColor: ${separation};
    qproperty-baseFillColor: ${input};
    qproperty-selectedFillColor: ${accent_checked};
    qproperty-textColor: ${text};
}

/* Self-painted input widgets (scrubbers, pill toggle, colour swatch) have no
   QSS border/padding of their own, so min/max-height IS their outer height.
   Pin them to size_input_outer_height so they match the native inputs + each other. */
PJ--ScrubberBase, PJ--CheckButton, PJ--DualOptionsWidget, PJ--ColorPickerWidget {
    min-height: ${size_input_outer_height}px;
    max-height: ${size_input_outer_height}px;
}
/* A vertical DualOptionsWidget stacks its segments, so the single-row cap above
   would crush them. Lift it and let the widget's own stacked height hint win. */
PJ--DualOptionsWidget[pjOrientation="vertical"] {
    min-height: 0;
    max-height: 16777215;
}

/* A control docked inside a SectionHeaderBand is sized to the band height so it
   reads as part of the strip. The caps above (and the native input caps) are
   applied by QStyleSheetStyle over the layout, so they have to be lifted here or
   the band's fixed height could never take effect. */
PJ--ScrubberBase[pjBandDocked="true"],
PJ--CheckButton[pjBandDocked="true"],
PJ--DualOptionsWidget[pjBandDocked="true"],
PJ--ColorPickerWidget[pjBandDocked="true"],
QLineEdit[pjBandDocked="true"],
QAbstractSpinBox[pjBandDocked="true"],
QComboBox[pjBandDocked="true"] {
    min-height: 0;
    max-height: 16777215;
}

/* Scene-control icon buttons (eye / add / trash / grid-style / copy-paste) sit in
   grid layouts, so QStyleSheetStyle — not the C++ setFixedSize — governs their size
   once the app stylesheet is active. On HiDPI the tool-button icon metric can be
   24px, which would otherwise grow the button to ~26px and break the alignment.
   Pin every QToolButton in the panel to the input height so they match the inputs
   and the Topics-table eyes (which are setGeometry'd to the same size). */
PJ--Scene3DConfigPanel QToolButton {
    min-width: ${size_input_outer_height}px;
    max-width: ${size_input_outer_height}px;
    min-height: ${size_input_outer_height}px;
    max-height: ${size_input_outer_height}px;
    padding: ${space_none}px;
}

/* 2-px leading padding so the section titles ("Sources", "Datasets",
   "Custom Series", "Curves") don't butt up against the band's left edge. */
QLabel#labelInput,
QLabel#labelTimeseries,
QLabel#labelCustom,
QLabel#labelCurves,
QLabel#timelineDatasetsLabel {
    padding-left: ${space_tight}px;
}

/* Static 1-px border on the left edge of the global column, separating
   the plot area from the global icon strip. Not a splitter handle —
   purely visual; the only draggable boundary is between the global
   column and the local panel. */
QFrame#globalToolbarLeftBorder,
QFrame#timelineAlignBorder,
QFrame#timelinePlaybackBorder {
    background-color: ${separation};
    border: none;
}

/* ---------- Chrome buttons (TitleBar + dialog title bars) ----------
   Button/icon geometry comes from the runtime ChromeMetrics broadcast
   (icon_size + icon_padding), not from QSS. Padding stays 0 because every
   button already carries its icon with a ring of chrome padding around it —
   additional QSS padding would crush the icon. */
#TitleBar QToolButton,
#TitleBar QPushButton#plotTabsPanelButton,
QDialog QToolButton#buttonClose {
    background: transparent;
    border: none;
    color: ${text};
    padding: ${space_none}px;
    border-radius: ${radius_input}px;
}

#TitleBar QToolButton:hover,
#TitleBar QPushButton#plotTabsPanelButton:hover,
QDialog QToolButton#buttonClose:hover {
    background: ${overlay_hover};
}

#TitleBar QToolButton:pressed,
#TitleBar QPushButton#plotTabsPanelButton:pressed,
QDialog QToolButton#buttonClose:pressed {
    background: ${overlay_pressed};
}

/* Qt's QToolButton stamps a dropdown indicator any time setMenu() is
   used. We pop menus by hand (see TitleBar::wire_popup) but Qt still
   paints the indicator subcontrols. Zero them out so they don't
   bleed into chrome icons. */
#TitleBar QToolButton::menu-indicator,
#TitleBar QToolButton::menu-button,
#TitleBar QToolButton::menu-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

/* Close glyphs (window-close in TitleBar + dialog) get the error interaction
   treatment to call out the destructive action. */
#TitleBar QToolButton#buttonClose:hover,
QDialog QToolButton#buttonClose:hover {
    background: ${destructive_hovered};
}

#TitleBar QToolButton#buttonClose:pressed,
QDialog QToolButton#buttonClose:pressed {
    background: ${destructive_nominal};
    color: ${on_destructive_nominal};
}

QDialog QLabel#dialogTitleLabel {
    color: ${text};
    padding-left: ${space_snug}px;
}

/* Recording page: the two one-line section notes read as headings. */
QLabel#labelRecordingNote,
QLabel#labelSourceCacheNote {
    font-weight: 600;
}

/* PreferencesDialog two-pane body --------------------------------------
   The section list (left) is the recessed titlebar tone; the settings
   pane (right) is the lighter dialog surface, so the active
   page reads as a brighter "paper" against the darker index. 1-px
   `navSeparator` / `buttonBarSeparator` hairlines split the three
   regions. Rows are PreferencesNavRow (QFrame#navRow); the selected row
   paints a tinted fill, no accent edge. */
QScrollArea#navScrollArea {
    background: ${banner};
    border: none;
}
QScrollArea#navScrollArea > QWidget > QWidget#navContainer {
    background: ${banner};
}
QFrame#navRow {
    background: transparent;
    border: none;
}
QFrame#navRow:hover {
    background: ${overlay_hover};
}
QFrame#navRow[selected="true"] {
    background: ${accent_checked};
}
QLabel#navRowLabel {
    background: transparent;
    color: ${text};
}
/* Right-hand settings pane: the lighter surface the section list sits
   against. Both the stack and its page children are transparent by
   default (they would show the darker dialog body), so fill both. */
QStackedWidget#pagesStack {
    background: ${backdrop};
}
QStackedWidget#pagesStack > QWidget {
    background: ${backdrop};
}
/* Hairline dividers between the three regions (1-px QFrames sized in
   the .ui). */
QFrame#navSeparator,
QFrame#buttonBarSeparator {
    background: ${separation};
    border: none;
}
/* Folder/table lists in the Preferences pages read as input surfaces — the
   input surface with a hairline border — so they separate from the
   page behind them. */
QStackedWidget#pagesStack QListWidget,
QStackedWidget#pagesStack QListView {
    background: ${input};
    border: 1px solid ${separation};
}
/* Roomier rows so list entries aren't cramped. */
QStackedWidget#pagesStack QListWidget::item,
QStackedWidget#pagesStack QListView::item {
    padding-top: ${space_snug}px;
    padding-bottom: ${space_snug}px;
}

/* "Close Plot Area" button (DockToolbar uses QPushButton, not the
   QToolButton that title bars use — covered by its own selector). */
QPushButton#buttonClose:hover {
    background: ${destructive_hovered};
}

QPushButton#buttonClose:pressed {
    background: ${destructive_nominal};
}

/* DiagnosticsPopup ------------------------------------------------ */

QFrame#DiagnosticsPopup {
    background: ${backdrop};
    background-color: ${backdrop};
    color: ${text};
    border: 1px solid ${separation};
    border-radius: ${radius_square};
}

/* When the cursor is over the drag handle or a resize drag is in
   progress, the popup's own bottom border swaps to purple. Painting
   the line on the popup (rather than on the inner #dragHandle) lets
   it meet the side borders at the corners without the inset that
   rootLayout's side margins would otherwise impose. The "dragActive"
   dynamic property is toggled in DiagnosticsPopup::setDragActive(). */
QFrame#DiagnosticsPopup[dragActive="true"] {
    border-bottom: 1px solid ${separation};
}

QFrame#DiagnosticsCard {
    background-color: transparent;
    border: none;
    border-radius: ${radius_square};
}

QFrame#DiagnosticsCard:hover {
    background-color: ${accent_checked};
}

QFrame#DiagnosticsCard QLabel#cardTimestamp {
    color: ${text};
}

QToolButton#cardCopyButton {
    border: none;
    background: transparent;
    padding: ${space_none}px;
}

QToolButton#cardCopyButton:hover {
    background: ${accent_checked};
    border-radius: ${radius_input}px;
}

QLabel#DiagnosticsEmptyState {
    color: ${on_backdrop_disabled};
}

/* Drag-to-resize handle — purely a transparent hit zone. The visible
   bottom line is the popup's own border, which is recoloured via the
   parent's [dragActive] property (toggled from the C++ event filter
   on this handle). */
QFrame#dragHandle {
    background: transparent;
    border: none;
    margin: ${space_none}px;
    min-height: 4px;
    max-height: 4px;
}

/* ---------- Marketplace cards + status accents ----------
   Card surface, hover, and the per-state action buttons (Install /
   Update / "Local newer" / "Needs Restart" / Installed). Replaces
   inline setStyleSheet calls in pj_marketplace/src/ui/. */

QScrollArea#scroll_area_,
QScrollArea#scroll_area_ > QWidget > QWidget {
    background: ${backdrop};
}

/* Detail pane (right of the splitter): the lighter "paper" surface the
   selected card's full description sits against, distinct from the list's
   backdrop tone. */
QScrollArea#detail_scroll_,
QScrollArea#detail_scroll_ > QWidget > QWidget {
    background: ${surface_dialog};
}

QFrame#extCard {
    background: ${neutral_nominal};
    color: ${on_neutral_nominal};
    border: none;
}

QFrame#extCard:hover {
    background: ${neutral_hovered};
}

/* Selected card in the master–detail view: its details fill the right panel.
   One shade past hover, so the selected card stays distinguishable from a
   transient hover without a border accent. */
QFrame#extCard[selected="true"] {
    background: ${neutral_pressed};
}

/* Preferences registry-URL editor: red text while the entered URL is invalid
   or unreachable (advisory edit-finish validation in PreferencesDialog). */
QLineEdit#lineEditRegistryUrl[urlError="true"] {
    color: ${status_error};
}

/* Card child labels — version readout, description — inherit the
   card's text colour rather than going through palette(text). */
QFrame#extCard QLabel {
    color: ${on_neutral_nominal};
    background: transparent;
}

QLabel#extCardDescription {
    color: ${text};
    font-size: 11px;
}

/* VS Code-style details footer: a greyish panel below the plugin table,
   separated by a top hairline, showing the selected plugin's description +
   changelog + metadata. */
QFrame#marketplaceDetailFooter {
    background: ${backdrop};
    border: 1px solid ${separation};
    border-radius: ${radius_input}px;
}
QFrame#marketplaceDetailFooter QTextBrowser {
    background: transparent;
    color: ${text};
    border: none;
}

/* Status badges: labels, not emphasis, so normal weight. */
QPushButton#extBadgeInstalled,
QPushButton#extBadgeNeedsRestart,
QPushButton#extBadgeInstalling,
QPushButton#extBadgeUpdate,
QPushButton#extBadgeLocalNewer {
    font-weight: normal;
}

/* Downgrade-to-bundled: a core plugin updated above its bundled version. Uses
   the framework's Destructive tokens to read as a "revert/remove" action
   distinct from Install/Update. Sits on the detail dialog's uninstall_btn, so it
   keeps that button's rounded shape. */
QPushButton#extButtonDowngrade {
    border: none;
    border-radius: ${radius_input}px;
    padding: ${space_snug}px ${space_comfortable}px;
    font-weight: 600;
    background: ${destructive_nominal};
    color: ${on_destructive_nominal};
}
QPushButton#extButtonDowngrade:hover { background: ${destructive_hovered}; color: ${on_destructive_hovered}; }

/* Footer action buttons (Update/Install/Installed/Uninstall/Visit Website) share
   one uniform geometry so they all read as the same size. Pinned here (not via
   setFixedWidth) because these buttons are QSS-styled and QStyleSheetStyle
   governs their geometry. The min-width is the content box; identical padding on
   every button makes the TOTAL widths equal (min-width ≥ the widest label,
   "Visit Website", so none overflow and all render at the same width). Downgrade
   is exempt — its label is far longer — so it does not carry the property. */
QPushButton[mpFooterButton="true"] {
    min-width: 110px;
    padding: ${space_snug}px ${space_comfortable}px;
    border: none;
    border-radius: ${radius_input}px;
}

/* Semantic → framework family mapping (ui_framework.md §Interactions):
   Install = Accent (action), Update/NeedsRestart = Emphasis (soft attention),
   Installed = Accent (positive confirmation), LocalNewer/Installing = Neutral
   (quiet). Badges are :disabled to be non-clickable, but keep the nominal fill
   (not the greyed disabled step) so they still read as coloured status chips. */
QPushButton#extButtonInstall            { background: ${accent_nominal}; color: ${on_accent_nominal}; }
QPushButton#extButtonInstall:hover      { background: ${accent_hovered}; color: ${on_accent_hovered}; }
/* Update: a single soft-pink tone — the SAME fill as the updatable plugin rows
   (destructive_nominal #CC00CC at 0.22 alpha), with normal body ink. One colour;
   hover/pressed only deepen its alpha for click feedback (like the Install
   button's state shift). Keep in sync with UpdateRowDelegate's alpha. */
QPushButton#extButtonUpdate             { background: rgba(204, 0, 204, 0.22); color: ${text}; }
QPushButton#extButtonUpdate:hover       { background: rgba(204, 0, 204, 0.34); color: ${text}; }
QPushButton#extButtonUpdate:pressed     { background: rgba(204, 0, 204, 0.48); color: ${text}; }
QPushButton#extBadgeInstalled:disabled  { background: ${accent_nominal}; color: ${on_accent_nominal}; }
QPushButton#extBadgeNeedsRestart:disabled { background: ${emphasis_nominal}; color: ${on_emphasis_nominal}; }
QPushButton#extBadgeLocalNewer:disabled { background: ${neutral_nominal}; color: ${on_neutral_nominal}; }
QPushButton#extBadgeInstalling:disabled { background: ${neutral_nominal}; color: ${on_neutral_nominal}; }

/* Update-All button: the same single soft-pink tone as the Update button and the
   updatable rows, shown exactly when enabled (i.e. when at least one extension
   has an update pending); hover/pressed deepen the alpha for click feedback.
   Disabled (nothing to update) falls back to the default look. */
QPushButton#update_all_btn_:enabled         { background: rgba(204, 0, 204, 0.22); color: ${text}; }
QPushButton#update_all_btn_:enabled:hover   { background: rgba(204, 0, 204, 0.34); color: ${text}; }
QPushButton#update_all_btn_:enabled:pressed { background: rgba(204, 0, 204, 0.48); color: ${text}; }

/* Tag chip in the extension-detail dialog. Uses the same card surface
   tone so chips feel like inset elements of the card. */
QLabel#extTagChip {
    background: ${neutral_nominal};
    border: 1px solid ${separation};
    padding: ${space_tight}px ${space_comfortable}px;
    font-size: 11px;
}

/* Marketplace status banner — sticky error state. */
QLabel#marketplaceStatusError {
    /* Error STATUS ink, not the highlight interaction fill (near-invisible as text). */
    color: ${status_error};
    font-weight: 600;
}

/* ---------- PJ::MessageBox ----------
   See stylesheet_dark.qss for the design rationale. Light theme uses the
   same selectors with theme-relative tokens; the gradient stops
   are theme-agnostic and read the same in
   either chrome, so the primary button looks identical in both themes. */

/* Dialog window itself is fully transparent — the rounded card inside it
   carries all the visible paint. Combined with WA_TranslucentBackground in
   C++, the corner pixels outside the card are alpha=0 so the dialog has
   true rounded corners without relying on setMask (which Wayland
   compositors silently drop). */
QDialog#pjMessageBox {
    background: transparent;
}

QFrame#pjMessageBoxCard {
    background: ${backdrop};
    border: 1px solid ${separation};
    border-radius: ${radius_dialog}px;
}

QLabel#pjMessageBoxTitle {
    color: ${text};
    font-size: 12pt;
    font-weight: 600;
}

QLabel#pjMessageBoxBody {
    color: ${text};
}

QPushButton#pjMessageBoxButton {
    min-height: 26px;
    padding: ${space_comfortable}px ${space_section}px;
    border: none;
    /* Softer corners (radius_card) than the app's flat surfaces (radius_square):
       the message box is a distinct modal moment and reads as more dialog-y. */
    border-radius: ${radius_card}px;
    font-weight: 600;
}

/* Special variant (ui_framework.md § Interactions): a per-state gradient from
   the Accent endpoint to the Highlight endpoint. */
QPushButton[msgbox_role="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 ${accent_nominal},
                                stop:1 ${highlight_nominal});
    color: ${on_special_nominal};
}

QPushButton[msgbox_role="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 ${accent_hovered},
                                stop:1 ${highlight_hovered});
    color: ${on_special_hovered};
}

QPushButton[msgbox_role="neutral"] {
    background: ${neutral_nominal};
    color: ${text};
}

QPushButton[msgbox_role="neutral"]:hover {
    background: ${neutral_hovered};
    color: ${text};
}

QPushButton[msgbox_role="cancel"] {
    background: ${cancel_nominal};
    color: ${text};
}

QPushButton[msgbox_role="cancel"]:hover {
    background: ${cancel_hovered};
    color: ${text};
}

QPushButton[msgbox_role="destructive"] {
    background: ${neutral_nominal};
    color: ${destructive_ink};
}

QPushButton[msgbox_role="destructive"]:hover {
    background: ${destructive_hovered};
    color: ${on_destructive_hovered};
}

/* QFileDialog (non-native) ---------------------------------------------- */
/* The native GTK dialog crashes on this app's libpng ABI skew (see
   pj_app/CMakeLists.txt), so we force the Qt-drawn dialog with
   DontUseNativeDialog and skin it here. Most of its inner widgets
   (QPushButton, QComboBox, QLineEdit, QTreeView, QListView) already
   pick up the cascade; the rules below target the parts that don't.
   The sidebar/frame deliberately carry no border — the splitter handle
   between them already paints a 1px divider (see QSplitter::handle). */

QFileDialog QListView#sidebar {
    background: ${backdrop};
    /* Three-sided border — the splitter handle on the right already paints
       the divider, so we omit border-right to avoid a 2 px stacked line. */
    border-top: 1px solid ${separation};
    border-left: 1px solid ${separation};
    border-bottom: 1px solid ${separation};
    border-right: none;
    padding: ${space_tight}px ${space_none}px;
}

QFileDialog QListView#sidebar::item {
    padding: ${space_snug}px ${space_comfortable}px;
}

QFileDialog QListView#sidebar::item:selected {
    background-color: ${accent_checked};
    color: ${on_accent_checked};
}

QFileDialog QFrame#frame {
    background: transparent;
    /* Three-sided border — the splitter handle on the left already paints
       the divider, so we omit border-left to avoid a 2 px stacked line. */
    border-top: 1px solid ${separation};
    border-right: 1px solid ${separation};
    border-bottom: 1px solid ${separation};
    border-left: none;
}

QFileDialog QToolButton {
    padding: ${space_tight}px;
}

/* ---- Mosaico panel: 3-column splitter -----------------------------------
   The seq / topic / dataView columns are QFrames inside mainSplitter. No box
   border: the only separators are the two QSplitter handles between the columns
   (1px border-grey lines; see QSplitter::handle), so the columns run full-width
   edge-to-edge with no outer frame, and no padding so the content fills the
   column (header bar flush under the Server band, tables to the edges). */
QFrame#seqPanelContainer,
QFrame#topicPanelContainer,
QFrame#dataViewContainer {
    border: none;
    padding: ${space_none}px;
    background-color: ${data_backdrop};
}

/* Panel surfaces — plottable/editable containers are DATA surfaces
   (${data_backdrop}: pure white in light, lighter than the backdrop in dark)
   EXCEPT the four title-bar-tone header bands (server / seq / topic / info),
   which keep ${banner}. Covers the panel root, the body wrapper, the Lua query
   pane + its editor, both tables, and the Info text area — mirroring the dark
   stylesheet's block exactly. Set here rather than inline in the .ui so the
   surface follows the active theme. */
QWidget#MosaicoPanel,
QWidget#mosaicoBody,
QWidget#queryPane,
QTableWidget#seqTable,
QTableWidget#topicTable,
QPlainTextEdit#dataView,
QPlainTextEdit#lua_queryBar {
    background-color: ${data_backdrop};
}

/* Cell grid for the Sequences / Topics tables: INTERIOR dividers only, no outer
   border. These tables opt in (pjInteriorGrid, set in mosaico_panel.ui) to the
   host's InteriorGridDelegate, which turns native showGrid OFF and paints interior
   column dividers plus a bottom rule under every row (incl. the last), but no
   outer-left/right line. So the side edges are owned solely by the surrounding
   chrome (column header, splitter handle): one clean line, never a double. The
   per-row bottom rule closes the data (a short table has empty space, not chrome,
   below it). gridline-color still feeds the
   delegate — it reads the grid color via SH_Table_GridLineColor exactly as the
   native grid would, so this token themes the interior dividers. border:none drops
   the frame. Do NOT re-add ::item border masks here: Qt silently drops per-::item
   left/right borders and instead tints every column edge in the selection color
   (the old blue double line). The delegate, not QSS, makes this grid correct. */
QTableWidget#seqTable,
QTableWidget#topicTable {
    gridline-color: ${separation};
    border: none;
}

/* The Server URL dropdown + the Lua query-assist dropdowns (Key/Op/Value) are
   pinned to 26px content (28px outer) instead of the global size_input_min_height
   cap, so the URL combo fills its header band and the Lua combos match it. */
QComboBox#comboUri,
QComboBox#keyCombo,
QComboBox#opCombo,
QComboBox#valCombo {
    min-height: 26px;
    max-height: 26px;
}

/* DateRangePicker date fields (the calendar line edits) match the dropdown height. */
QWidget#datePicker QLineEdit {
    min-height: 26px;
    max-height: 26px;
}

/* The calendar overlay's time scrubbers + month/year combos match that same
   dropdown height, so the time rows don't read shorter than the date fields and
   metadata-filter dropdowns. Scoped to the overlay (PickerOverlay) so it overrides
   the global input caps only here. */
QWidget#PickerOverlay PJ--ScrubberBase,
QWidget#PickerOverlay QComboBox {
    min-height: 26px;
    max-height: 26px;
}

/* 1px divider under the Server header container, separating it from the body. */
QFrame#serverSeparator,
QFrame#rangeSeparator {
    background-color: ${separation};
}

/* The bands' icon buttons are flat QPushButtons (the dialog host only wires
   QPushButton clicks); SectionHeaderBand sizes them to the chrome metrics
   (bandHeight box / icon_size icon). Drop the default 6px QPushButton padding so
   the icon fills the button like the Sources QToolButtons do; flat=true already
   removes the surface + border, leaving the shared hover/pressed overlays. */
QPushButton#buttonConnect[flat="true"],
QPushButton#buttonCert,
QPushButton#buttonReloadSeq,
QPushButton#buttonReloadTopic,
QPushButton#buttonAddClause,
QPushButton#seqRegexToggle,
QPushButton#topicRegexToggle {
    padding: ${space_none}px;
}

/* PJ::ProgressBar — the rounded "Loading …" bar. Scoped to the subclass so
   the plain QProgressBar in ProgressDialog keeps the default look. The caption
   is the QProgressBar format() string, drawn once on top of the fill in a
   single colour (it does not split where the fill crosses behind it). */
PJ--ProgressBar {
    border: 2px solid ${progress_outline};
    border-radius: ${radius_pill}px;
    background: ${progress_track};
    text-align: center;
    color: ${on_progress};
    min-height: 30px;
    font-size: 11pt;
}

/* The fill is inset via `margin` so it floats inside the outline; its own
   border-radius rounds the trailing edge as it grows. */
PJ--ProgressBar::chunk {
    background-color: ${progress_indicator};
    border-radius: ${radius_pill}px;
    margin: ${space_tight}px;
}

/* The ingest bar lives in the title bar, so it is shorter + thinner than the
   standalone "Loading" bar to fit the chrome row (more specific selector wins). */
PJ--IngestProgressWidget PJ--ProgressBar {
    min-height: 0px;
    max-height: 20px;
    border-width: 1px;
    border-radius: ${radius_pill}px;
    font-size: 9pt;
}
PJ--IngestProgressWidget PJ--ProgressBar::chunk {
    border-radius: ${radius_pill}px;
    margin: ${space_tight}px;
}

/* Toast Notification ----------------------------------------------------- */

PJ--ToastNotification {
    background-color: ${backdrop};
    border: 1px solid ${separation};
    border-radius: ${radius_card}px;
    min-width: 250px;
    max-width: 400px;
}

PJ--ToastNotification QLabel#toastMessage {
    color: ${text};
    font-size: 10pt;
}

PJ--ToastNotification QLabel#toastIcon {
    background: transparent;
}

PJ--ToastNotification QPushButton#toastCloseButton {
    background: transparent;
    border: none;
    color: ${on_backdrop_disabled};
    font-size: 14pt;
    font-weight: 600;
    padding: ${space_none}px;
    margin: ${space_none}px;
}

PJ--ToastNotification QPushButton#toastCloseButton:hover {
    color: ${text};
}
