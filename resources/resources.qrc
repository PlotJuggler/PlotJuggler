<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/resources">
    <file alias="stylesheet_light.qss">stylesheet_light.qss</file>
    <file alias="stylesheet_dark.qss">stylesheet_dark.qss</file>
    <!-- Square PlotJuggler logo, composed into the "serious" splashscreen. -->
    <file alias="plotjuggler.svg">plotjuggler.svg</file>
    <!-- "Success kid" meme icon shown in the "new release available" toast. -->
    <file alias="success_kid.png">success_kid.png</file>
    <file alias="crying_cat.png">crying_cat.png</file>
    <!-- Bundled UI font (SIL OFL 1.1). Loaded at startup via
         QFontDatabase::addApplicationFont and set as the application font, so
         typography is controlled and consistent across machines instead of
         relying on the host's default sans-serif. The variable font covers the
         whole weight axis, so font-weight 400/600/700 resolve to real masters
         (not synthesized bold). -->
    <file alias="fonts/NotoSans/NotoSans-Variable.ttf">fonts/NotoSans/NotoSans-Variable.ttf</file>
  </qresource>
  <qresource prefix="/resources">
    <!-- Funny splashscreen pool. The startup splash enumerates this directory
         at runtime (QDir(":/resources/memes")), so adding a meme is a pure
         resource change: drop meme_NN.jpg here and list it below. -->
