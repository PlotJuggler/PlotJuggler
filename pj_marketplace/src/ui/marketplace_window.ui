<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MarketplaceWindow</class>
 <widget class="QWidget" name="MarketplaceContent">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>760</width><height>520</height></rect>
  </property>
  <layout class="QVBoxLayout" name="main_layout">
   <property name="spacing"><number>8</number></property>
   <property name="leftMargin"><number>8</number></property>
   <property name="topMargin"><number>8</number></property>
   <property name="rightMargin"><number>8</number></property>
   <property name="bottomMargin"><number>8</number></property>

   <!-- Toolbar — single row: category filters (left) · search · action buttons (right).
        Category toggles are additive: with all four checked (default) every registry
        category is visible; with all four unchecked the table is empty. The user-facing
        button labels differ from the registry "category" values, which live in
        applyFilters(). filter_compatible_ / filter_installed_ are hidden for now — the
        compatibility gate keeps running on filter_compatible_'s default-checked state. -->
   <item>
    <layout class="QHBoxLayout" name="toolbar_layout">
     <property name="spacing"><number>6</number></property>
     <item>
      <widget class="PJ::CheckButton" name="filter_data_loader_">
       <property name="checked"><bool>true</bool></property>
       <property name="text"><string>Data Sources</string></property>
       <property name="toolTip"><string>Extensions that load data from files</string></property>
      </widget>
     </item>
     <item>
      <widget class="PJ::CheckButton" name="filter_data_streamer_">
       <property name="checked"><bool>true</bool></property>
       <property name="text"><string>Data Streamers</string></property>
       <property name="toolTip"><string>Extensions that stream data continuously</string></property>
      </widget>
     </item>
     <item>
      <widget class="PJ::CheckButton" name="filter_parser_">
       <property name="checked"><bool>true</bool></property>
       <property name="text"><string>Parsers</string></property>
       <property name="toolTip"><string>Extensions that decode byte blobs into fields</string></property>
      </widget>
     </item>
     <item>
      <widget class="PJ::CheckButton" name="filter_toolbox_">
       <property name="checked"><bool>true</bool></property>
       <property name="text"><string>Toolboxes</string></property>
       <property name="toolTip"><string>Extensions that add a tool with its own GUI</string></property>
      </widget>
     </item>
     <item>
      <widget class="PJ::CheckButton" name="filter_compatible_">
       <property name="visible"><bool>false</bool></property>
       <property name="text"><string>Compatible only</string></property>
       <property name="toolTip"><string>Show only plugins compatible with this PlotJuggler build (installed ones stay visible)</string></property>
      </widget>
     </item>
     <item>
      <widget class="PJ::CheckButton" name="filter_installed_">
       <property name="visible"><bool>false</bool></property>
       <property name="text"><string>Installed only</string></property>
       <property name="toolTip"><string>Show only extensions that are already installed</string></property>
      </widget>
     </item>
     <item>
      <widget class="PJ::Search" name="search_edit_">
       <property name="placeholder"><string>Search extensions...</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="install_local_btn_">
       <property name="text"><string>Install local...</string></property>
       <property name="toolTip"><string>Install a plugin from a local ZIP. The archive is not from the registry, so its origin cannot be verified — only that it holds a loadable plugin. Replacing an already-installed extension takes effect on the next restart.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="update_all_btn_">
       <property name="text"><string>Update All</string></property>
       <property name="toolTip"><string>Update every installed extension that has a newer version available</string></property>
       <!-- fixedWidth(90) set in C++ -->
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="settings_btn_">
       <property name="text"><string/></property>
       <property name="toolTip"><string>Plugin settings — open Preferences ▸ Plugins</string></property>
       <property name="iconSize"><size><width>18</width><height>18</height></size></property>
       <property name="maximumSize"><size><width>30</width><height>16777215</height></size></property>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Plugin table: Name / Enabled / Version / Installed (state button) /
        Description. Columns + resize modes are configured in setupUi(); the
        Description column stretches to take the leftover width. -->
   <item>
    <widget class="QTableWidget" name="plugin_table_">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
       <horstretch>0</horstretch><verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
    </widget>
   </item>

   <!-- Details footer (VS Code-style): a greyish panel BELOW the table showing
        the selected plugin's full description + changelog + metadata. Styled via
        the QFrame#marketplaceDetailFooter QSS rule; height is bounded so it never
        crowds out the table. -->
   <item>
    <widget class="QFrame" name="marketplaceDetailFooter">
     <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
     <property name="minimumSize"><size><width>0</width><height>68</height></size></property>
     <property name="maximumSize"><size><width>16777215</width><height>120</height></size></property>
     <layout class="QVBoxLayout" name="detail_footer_layout">
      <property name="leftMargin"><number>10</number></property>
      <property name="topMargin"><number>6</number></property>
      <property name="rightMargin"><number>10</number></property>
      <property name="bottomMargin"><number>6</number></property>
      <property name="spacing"><number>4</number></property>
      <!-- Header row at the plugin-title height: title on the left, and (only
           for installed plugins) a green enable/disable toggle on the right,
           mirroring the table's Enabled column. Wired in updateDetailFooter. -->
      <item>
       <layout class="QHBoxLayout" name="detail_header_layout">
        <property name="spacing"><number>8</number></property>
        <item>
         <widget class="QLabel" name="detail_title_">
          <property name="text"><string/></property>
          <property name="styleSheet"><string>font-weight:700; font-size:14px;</string></property>
         </widget>
        </item>
        <item>
         <spacer name="detail_header_stretch">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
         </spacer>
        </item>
        <item>
         <widget class="PJ::ToggleSwitch" name="detail_enable_toggle_"/>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QTextBrowser" name="detail_text_">
        <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
        <property name="openExternalLinks"><bool>true</bool></property>
       </widget>
      </item>
      <!-- Action row at the bottom-right (rebuilt per selection in
           updateDetailFooter): Visit Website + Uninstall/Downgrade + the primary
           action. A leading stretch is added in code to push them right. -->
      <item>
       <layout class="QHBoxLayout" name="detail_buttons_layout">
        <property name="spacing"><number>8</number></property>
       </layout>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Status bar -->
   <item>
    <layout class="QHBoxLayout" name="status_layout">
     <item>
      <widget class="QLabel" name="status_label_">
       <property name="text"><string/></property>
       <property name="wordWrap"><bool>true</bool></property>
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Minimum">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
	      </widget>
	     </item>
	     <item>
	      <widget class="QPushButton" name="diagnostics_btn_">
	       <property name="text"><string>Details</string></property>
	       <property name="toolTip"><string>Show marketplace diagnostics</string></property>
	       <property name="visible"><bool>false</bool></property>
	       <property name="maximumSize">
	        <size><width>80</width><height>16777215</height></size>
	       </property>
	      </widget>
	     </item>
	     <item>
	      <widget class="QProgressBar" name="progress_bar_">
       <property name="visible"><bool>false</bool></property>
       <property name="maximum"><number>100</number></property>
       <property name="value"><number>0</number></property>
       <property name="maximumSize">
        <size><width>150</width><height>16777215</height></size>
       </property>
      </widget>
     </item>
    </layout>
   </item>

  </layout>
 </widget>
