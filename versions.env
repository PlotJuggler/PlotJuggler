# Single source of truth for PJ4 versions (consumed by CMake, scripts, Docker, CI).
# PJ_APP_VERSION is the dev-build version; release CI overrides it with the git
# tag via PJ_VERSION. Plugin manifests gate on it (min_plotjuggler_version), so
# keep it at or above what the official plugins require.
PJ_APP_VERSION=4.1.0
PJ_QT_VERSION=6.12.0
# The WebAssembly build uses the same PJ_QT_VERSION. Qt 6.12 targets
# Emscripten 5.0.5; Node supplies deterministic compression. Keep both exact for
# reproducible WebAssembly release CI.
PJ_EMSCRIPTEN_VERSION=5.0.5
PJ_WASM_NODE_VERSION=22.22.1
# Caddy, the robot HTTPS host that WASM CI runs docs/wasm/Caddyfile with; the hash
# is the official linux_amd64 release archive's (caddy_<version>_checksums.txt).
PJ_CADDY_VERSION=2.11.7
PJ_CADDY_LINUX_AMD64_SHA512=a7a433a1b133efc3c8d10eb0b99d52a24b5ef5c322dc77f5282182b1c0402139ab83f3a99f0c52409df77d20123fb0b523edad8a66d8f5e49136197bf61ef0e7
PJ_APPIMAGE_ARCH=x86_64
