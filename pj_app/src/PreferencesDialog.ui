             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="toolTip">
            <string>Memory EACH recorded source may hold in flight. Once a source fills it, that source drops its largest queued messages rather than holding on to them. Recording several sources can hold this much for each of them.</string>
           </property>
           <property name="minimum">
            <number>8</number>
           </property>
           <property name="maximum">
            <number>4096</number>
           </property>
           <property name="value">
            <number>64</number>
           </property>
          </widget>
         </item>
         <item row="2" column="0" colspan="2">
          <widget class="QLabel" name="labelRecordingNote">
           <property name="text">
            <string>Recordings capture the raw messages of the topics each stream is subscribed to. Every Record press creates one folder holding one standard MCAP file per recorded source. Sources that write decoded samples directly (no message format) are not recorded. A stream is never held back by recording: if the disk cannot keep up, that source's recording drops its largest queued messages and keeps going.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="labelSourceCacheDir">
           <property name="text">
            <string>Source cache folder:</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <layout class="QHBoxLayout" name="sourceCacheDirRow">
           <property name="spacing">
            <number>2</number>
           </property>
           <item>
            <widget class="QLineEdit" name="lineEditSourceCacheDir">
             <property name="placeholderText">
              <string>default: app data folder / source_cache</string>
             </property>
             <property name="clearButtonEnabled">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="PJ::SvgButton" name="buttonSourceCacheDirBrowse"/>
           </item>
          </layout>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="labelSourceCacheBudget">
           <property name="toolTip">
            <string>Disk space the source cache may occupy. Oldest artifacts are removed first when the budget is exceeded; artifacts a loaded dataset still reads are never removed.</string>
           </property>
           <property name="text">
            <string>Source cache budget (GB):</string>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="PJ::IntScrubber" name="scrubberSourceCacheBudgetGB" native="true">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="toolTip">
            <string>Disk space the source cache may occupy. Oldest artifacts are removed first when the budget is exceeded; artifacts a loaded dataset still reads are never removed.</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>1000</number>
           </property>
           <property name="value">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="5" column="0">
          <widget class="QLabel" name="labelSourceCacheCapture">
           <property name="toolTip">
            <string>When on, each cloud download is also saved into the source cache so a saved layout can restore it offline. Applies immediately; turning it off never removes existing cached copies, and they keep restoring.</string>
           </property>
           <property name="text">
            <string>Capture downloads for offline restore:</string>
           </property>
          </widget>
         </item>
         <item row="5" column="1">
          <widget class="PJ::ToggleSwitch" name="sourceCacheCaptureToggle" native="true">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="toolTip">
            <string>When on, each cloud download is also saved into the source cache so a saved layout can restore it offline. Applies immediately; turning it off never removes existing cached copies, and they keep restoring.</string>
           </property>
          </widget>
         </item>
         <item row="6" column="0" colspan="2">
          <widget class="QLabel" name="labelSourceCacheNote">
           <property name="text">
            <string>The source cache keeps a local copy of each cloud download so a saved layout can restore it instantly and offline. It is disposable: entries are re-downloaded when missing. Changes to the folder and budget take effect the next time PlotJuggler starts; the capture toggle applies immediately.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item row="7" column="0" colspan="2">
          <spacer name="recordingBottomSpacer">
           <property name="orientation">
            <enum>Qt::Orientation::Vertical</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>0</width>
             <height>0</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </widget>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QFrame" name="buttonBarSeparator">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
